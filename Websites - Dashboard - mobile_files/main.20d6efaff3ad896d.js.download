t}} theme(s) selected","text_selectedAddOnsCount":"{{selectedAddOnsCount}} selected","text_search":"Search","text_searchDomain":"Search domain","text_searchPlugins":"Search Plugins","text_searchThemes":"Search Themes","text_uploadFile":"Upload File","text_uploadPluginMessage":"Upload and install .zip format plugin here","text_uploadThemeMessage":"Upload and install .zip format theme here","text_uploadInstalling":"Installing...","text_uploadInstallingMessage":"Your plugin is installing, please wait a few seconds.","text_uploadThemeInstallingMessage":"Your theme is installing, please wait a few seconds.","text_uploadSuccess":"Success!","text_uploadSuccessMessage":"Plugin is installed and activated.","text_uploadFailMessage":"Failed to upload plugin.","text_uploadThemeSuccessMessage":"Theme is installed.","text_uploadThemeFailMessage":"Failed to upload theme.","text_uploadFail":"Error!","text_uploadChooseFile":"Choose File","text_uploadTryAgain":"Try Again","text_activeThemeVersion":"Current version {{version}}","text_themeUpdateProcess":"Updating...","text_themeUpdateSuccess":"Your theme is up to date!","text_themeActivateProcess":"Activating...","text_themeActivateSuccess":"Your theme is activated!","text_started":"Started","text_duration":"Duration","text_checkingPerformance":"Checking a \u201c<span class=\'performance-website-title\'>{{websiteTitle}}</span>\u201d website\'s performance","text_checkingSecurity":"Checking a {{websiteTitle}} website\'s security","text_autoBackup":"Choose the backup schedule that suits your website best.","text_scheduleTitle":"Perfect for","text_scheduleDesc0":"Recommended for static websites","text_scheduleDesc1":"Recommended for websites with low traffic","text_scheduleDesc2":"Recommended for small websites with dynamic content","text_scheduleDesc3":"Recommended for websites  with daily content changes","text_scheduleDesc4":"Recommended for websites which have multiple content changes during a day","text_scheduleDesc5":"Recommended for websites which have hourly content updates","text_settingsStartTime":"Start Time*","text_settingsWeekDay":"Day","text_settingsDesc":"Scheduling uses the main account timezone.","text_settingsDate":"Date","text_settingsBackupScheduled":"Backups scheduled:","text_settingsBackupStartingAt":"Backups starting at:","text_settingsBackupExclude":"Choosing to exclude an option will also delete them from all the previously made backups","text_cancelSubscriptionTitle":"We are sorry to see you go!","text_cancelSubscriptionDesc":"Your feedback is important to us. Please take a minute to let us know<br/>why you are canceling your subscription.","text_amount":"Amount","text_datePaid":"Date paid","text_paidWith":"Paid with","text_invoice":"invoice","text_noPaymentMethodDesc":"Add a payment method to use<br/>10Web paid services","text_deletePaymentMethod":"remove","text_checkingBackup":"Running backup","text_paginationDisplay":"<span>{{firstItemPerPage}}-{{lastItemPerPage}}</span> of {{allItems}}","text_addWebsite":"Add Website","text_addWebsiteHostingTenWeb":"Hosted on 10Web","text_addWebsiteTitle":"Create a New WordPress Website","text_addWebsiteDesc":"Build your website using any theme & plugin,10Web builder and AI assistance.","text_addAnotherWebsite":"ADD ANOTHER WEBSITE","text_addWebsiteTabManually":"Manually","text_addWebsiteTabAutomatically":"Automatically","text_addWebsiteManuallyTitle":"Let\u2019s add a website manually","text_addWebsiteManuallyDescription1":"Please follow the steps below to add a website using 10Web Manager<br/>or","text_addWebsiteManuallyDescription":"The connection between your site and 10Web dashboard is established through 10Web manager plugin,<br>which you need to install either manually or","text_addWebsiteManuallyDescriptionSecond":"Please follow the steps below to add a website manually.","text_addWebsiteManuallySwitchToAutomatic":"add a website automatically.","text_addWebsiteManuallyStep1Title":"Download","text_addWebsiteManuallyStep1DescriptionXL":"Download the 10Web<br/>Manager plugin below.","text_addWebsiteManuallyStep1DescriptionXXL":"Download the 10Web<br/>Manager plugin below.","text_addWebsiteManuallyStep2Title":"Install","text_addWebsiteManuallyStep2DescriptionXL1":"Install the 10Web Manager<br/>plugin in your WordPress<br/>website.","text_addWebsiteManuallyStep2DescriptionXXL1":"Install the 10Web Manager<br/>plugin in your WordPress website.","text_addWebsiteManuallyStep2DescriptionXL":"Go to your WP dashboard <i>Plugins</i>, click <i>Add New</i>, <br/>search for <a class=\'db-link\' href=\'https://wordpress.org/plugins/10web-manager/\'>10Web Manager</a>, and click <i>Install Now</i>.","text_addWebsiteManuallyStep2DescriptionXXL":"Go to your WP dashboard <i>Plugins</i>, click <i>Add New</i>, <br/>search for <a class=\'db-link\' href=\'https://wordpress.org/plugins/10web-manager/\'>10Web Manager</a>, and click <i>Install Now</i>.","text_addWebsiteManuallyStep3Title":"Activate","text_addWebsiteManuallyStep3DescriptionXL":"Activate the 10Web Manager<br/>plugin with usual WordPress<br/>activation steps.","text_addWebsiteManuallyStep3DescriptionXXL":"Activate the 10Web Manager plugin<br/>with usual WordPress activation steps.","text_addWebsiteManuallyStep4Title":"Log in","text_addWebsiteManuallyConnectTitle":"Connect","text_addWebsiteManuallyConnectDescription":"Go to 10Web Manager in your WP dashboard and click <b>Connect</b>.","text_addWebsiteManuallyStep4DescriptionXL1":"Log into manager<br/>plugin with your 10Web<br/>user credentials.","text_addWebsiteManuallyStep4DescriptionXXL1":"Log into manager plugin with<br/>your 10Web user credentials.","text_addWebsiteManuallyStep4DescriptionXL":"Use your 10Web credentials to log into the plugin. ","text_addWebsiteManuallyStep4DescriptionXXL":"Use your 10Web credentials to log into the plugin. ","text_addWebsiteManuallyStep5Title1":"Go to dashboard","text_addWebsiteManuallyStep5Title":"Return to dashboard","text_addWebsiteManuallyStep5DescriptionXL":"Come back to 10Web dashboard to start using our services!","text_addWebsiteManuallyStep5DescriptionXXL":"Come back to 10Web dashboard to start using our services!","text_addWebsiteManuallyStep5DescriptionXL1":"Navigate to 10Web<br/>dashboard to start using<br/>our services.","text_addWebsiteManuallyStep5DescriptionXXL1":"Navigate to 10Web dashboard<br/>to start using our services.","text_addWebsiteDownloadManager":"Download 10web Manager","text_addWebsiteAutomaticallyTitle":"Let\u2019s automate the process.","text_addWebsiteAutomaticallyDescription":"Please enter your WordPress credentials below to<br/> add your website to 10Web dashboard.","text_addWebsiteAutomaticallySecurityInfo":"Please note that we need your admin credentials only for the purpose to install 10Web<br/>Manager plugin on your website. We care about your security and will not store your<br/>admin credentials. Check out more about 10Web Security ","text_addWebsiteAutomaticallySecurityInfoNoWrap":"Please note that we need your admin credentials only for the purpose to install 10Web Manager plugin on your website. We care about your security and will not store your admin credentials. Check out more about 10Web Security ","text_addWebsiteAutomaticallySecurityInfoLink":"here.","text_addWebsiteAutomaticallySwitchToManually":"If you don\'t want to provide your WordPress admin data, you can also choose to install<br/>10Web Manager Plugin ","text_addWebsiteAutomaticallySwitchToManuallyLink":"manually.","text_addWebsiteAutomaticallySecure":"Your details are secure","text_addWebsiteAutomaticallyButton":"Add Website","text_addWebsiteFieldPlaceholderUrl":"http://example.com","text_addWebsiteFieldPlaceholderUsername":"WordPress admin username","text_addWebsiteFieldPlaceholderPassword":"WordPress admin Password","text_confirmEmail":"Please check your email and confirm your email address to activate your account. If you don\'t see the email in your inbox shortly, check your spam folder.","text_emailConfirmed":"Great! Your account is now active. Please login.","text_confirmEmailLogin":"Login attempt limit exceeded, please try again later","text_alreadyHaveAnAccount":"Already have an account?","text_accountRecovery":"Account Recovery","text_signIn":"Sign in","text_checkYourEmail":"Check your email","text_checkYourEmailDesc":"Please check your email to reset your password.","text_resetEmailSent":"We just sent you an email with instructions on how to reset your password and log into your account. If you don\'t see the email in your inbox shortly, check your spam folder.","text_upgradePlanLabel":"your current plan","text_noActivePlugins":"No active plugins","text_noInActivePlugins":"No inactive plugins","text_noUpgradablePlugins":"Your plugins and themes are up to date.","text_noPlugins":"You have not installed any plugins yet!<br/>Please click the button below to install and<br/>start using plugins.","text_managementDashboard":"Unified website management dashboard","text_billingCycle":"Billing cycle","text_oneTimePayment":"One time payment","text_singleDomainCount":"Single product: {{domainCount}}","text_singleProductDomain":"{{domainCount}}","text_bundleDomainCount":"Premium bundle: {{domainCount}}","text_singleProduct":"Single product","text_bundleProduct":"Premium bundle","text_everyMonth":"{{periodNumber}} Months","text_somethingWentWrongLogOut":"Log out","text_somethingWentWrongDesc":"Please contact our <a class=\'db-link\' target=\'_blank\' href=\'https://10web.io/contact-us/\'>customer care team</a>.","text_oops":"Ooops!","text_sorry":"Sorry!","text_pageNotFound":"It seems we couldn\'t find the page you\'re looking for.","text_accountUpgradedHeader":"Congratulations!","text_accountUpgradedDesc":"Your plan has been successfully upgraded.","text_accountExtendedDesc":"Your plan has been successfully extended.","text_accountUpgradedPlatformDesc":"Your plan has been successfully upgraded to {{subscriptionTitle}}<br> <b>You can host {{hostedSites}} at 10Web with:</b>","text_accountUpgradedAppsumoDesc":"You have successfully upgraded to the {{subscriptionTitle}} Plan<br/><b>Your plan includes:</b>","text_accountUpgradedPersonalAdditionalDesc":"Upgrade to the Premium plan and get 2 more hosted websites<br/>and Multisite Support for ${{additionalPrice}}/{{subscriptionPeriod}}.","text_accountUpgradedPremiumAdditionalDesc":"Upgrade to the Agency plan and get 7 more<br/>hosted websites & the White Label feature for ${{additionalPrice}}/{{subscriptionPeriod}}.","text_accountUpgradedAdditionalDesc":"Upgrade to the {{plan}} plan and get {{websites}} more<br/> hosted websites for ${{price}}/{{period}}.","text_accountExtendedNotEnoughDesc":"Your referral credit is not enough for extending the plan.","text_continue":"Continue","text_close":"Close","text_generateCertificate":"ADD CERTIFICATE","text_removeCertificate":"REMOVE CERTIFICATE","text_changePaymentMethodTitle":"Change Credit Card","text_changePaymentMethodFromPaypalTitle":"Change default payment method","text_changePaymentMethodDesc":"Are you sure you want to make this card the default for<br/> collecting additional payments?","text_changeMainPaymentMethodDesc":"Are you sure you want to make this card<br/>the main payment method?","text_changeMainPaymentMethodCardDesc":"Are you sure you want to change your<br/>default payment method?","text_goHome":"Go Home","text_removePaymentMethodTitle":"Remove payment method","text_removePaymentMethodDesc":"Are you sure you want to remove this payment method?","text_reconnect":"Reconnect","text_inactiveWebsiteTitle":"Reconnect Your Website","text_inactiveWebsiteDesc":"To use 10Web plugins and services, please reconnect your website.","text_inactiveWebsiteFirstStep":"Please make sure that 10Web Manager plugin is installed and activated in your WordPress site dashboard.","text_inactiveWebsiteSecondStep":"Please make sure you\u2019re logged-in in Manager plugin with your 10Web credentials.","text_inactiveWebsiteStillDisconnected":"If your website fails to reconnect, contact our <a target=\'_blank\' href=\'https://10web.io/contact-us/\'>customer care team.</a>","text_updatePaidversion":"Update to {{paidVersion}}","text_getPremiumPlugin":"Get more features and higher service limits by upgrading to a plan that better suits your needs.","text_contactUsTitle":"Contact Us","text_contactUsDesc":"Contact our team anytime to receive support for 10Web products. Our customer care representatives will contact you within 24 hours (except on Sundays and holidays).","text_sendMessage":"send message","text_domainsExceededTitleDialog":"You exceeded the limit<br/> of websites.","text_domainsExceededUpgradeToPaid":"Upgrade to a paid plan to create or migrate more websites.","text_domainsExceededUpgradeToHigher":"Upgrade to a higher plan to create or migrate more websites.","text_domainsExceededContactOwner":"To host more websites, please contact the workspace owner.","text_domainsExceededBuyAdditional":"Buy additional sites to create, migrate or optimize<br/> more websites.","text_domainsExceededDescDialog":"You can upgrade to a higher plan to host more websites at 10Web.","text_domainsExceededDescDialogGoogleScore":"Please upgrade to be able to host more websites at 10Web.","text_domainsExceededDescDialogGoogleScoreAdditional":"Please add a website to to be able to host more websites at 10Web.","text_domainsExceededDescDialogStarter":"Create a super optimized website hosted at 10Web","text_domainsExceededTitle":"Website limit exceeded","text_domainsExceededDescription":"You have exceeded the limit of websites you can add with your current plan.<br/>Seems like it\'s time to upgrade! Click on the button below to check out 10Web plans and upgrade.","text_welcomeDialogTitle":"Welcome to 10Web !","text_welcomeDialogSingleProductDesc":"Single Product plan - {{pluginName}} Premium is all yours.<br>Having you on board is picture-perfect.","text_welcomeDialogDesc":"You\u2019re right in the middle of our vision for how websites should be<br> created and run. We\u2019re psyched to have you on board and can\u2019t wait to<br> show you around.","text_welcomeDialogSingleProductTitle":"To start using the plugin you purchased:","text_welcomeDialogFirstStep":"add a new website (no fuss, we\u2019ll tell you how, if anything)","text_welcomeDialogSecondStep":"install the plugin from 10Web dashboard\u2019s plugin page","text_letsStart":"LET\'S EXPLORE","text_letsGetStarted":"LET\'S GET STARTED","text_steps":"Step {{stepNumber}}","text_createWebsite":"How do you want to proceed?","text_installNewWebsite":"Create a Brand New WordPress Website","text_installWebsiteActivationFlow1":"Build your website using any theme & plugin,<br/> 10Web builder and AI assistance.","text_installNewWebsite2":"Migrate Your Website","text_installWebsiteActivationFlow2":"Automatically create an optimized copy of<br/> your website on 10Web Hosting.","text_installNewWebsiteLTDWithoutAdditional":"Create a New Website on 10Web Hosting","text_installNewWebsiteLTDWithAdditional":"Build a Website on 10Web Hosting","text_installNewWebsiteLTDWithoutAdditionalDesc":"Build a website with AI assistance on Automated WP Hosting<br/>powered by Google Cloud at the fixed price of $72/year","text_installNewWebsiteLTDWithoutAdditionalDescMonth":"Build a website with AI assistance on Managed WP Hosting <br>powered by Google Cloud at the fixed price of $6/month","text_installNewWebsiteLTDWithAdditionalDesc":"Host on 10Web Manged WordPress Hosting<br/>powered by Google Cloud","text_installNewWebsiteLTDWithAdditionalExceededDesc":"Hosted website limit reached. To host more sites, please upgrade.<br/>Get an additional hosted website for ${{price}}/year.","text_installNewWebsiteLTDWithAdditionalExpiredDesc":"Your hosting has expired. To continue using 10Web hosting<br/>you need to renew the payment.","text_installNewSubWebsite":"Add new site to multisite network","text_notHaveHosting":"Host on 10Web Automated hosting. Take advantage of our AI Website Builder with AI assistance.","text_notHaveHostingAdditional":"You\u2019ve exceeded the limit of your hosted websites.<br/> Upgrade to a higher plan to be able to host more websites at 10Web.","text_notHaveHostingAdditionalConnected":"You\u2019ve exceeded the limit of your connected websites.<br/> Upgrade to a higher plan to be able to connect and manage<br/>more websites on 10Web.","text_notHaveHostingAdditionalConnectedAI":"You\u2019ve reached the limit of recreated websites.<br/>To recreate more websites, please upgrade.","text_notHaveConnectedAdditional":"You\u2019ve exceeded the limit of your connected websites.<br/>To be able to install your <b>{{pluginTitle}}</b> plugin in a new<br/>website, you need to upgrade to a higher plan.","text_notHaveConnectedAdditionalBundle":"You\u2019ve exceeded the limit of your connected websites.<br/>To be able to install your plugin bundle in a new website,<br/>you need to upgrade to a higher plan.","text_haveHostingAdditionalBuyNow":"You\u2019ve exceeded the limit of your hosted websites.<br/> To be able to create another website you need to buy an additional site.","text_haveHostingAdditionalContactUs":"You\u2019ve exceeded the limit of your connected websites.<br/> To be able to connect another website contact our support team.","text_haveAdditionalTooltip":"The payment amount is calculated based on the remaining period of your current subscription plan.","text_addYourWebsite":"Connect/Migrate your website","text_automaticallyCreateOptimized":"Automatically create an optimized copy of your website <br> on 10Web Hosting.","text_exceededLimitConnected":"You\'ve exceeded the limit of your connected websites.<br/> Upgrade to be able to connect and manage more websites on 10Web.","text_haveHosting":"Connect to 10Web dashboard to use our services. You can also test<br/> your current website\'s speed on our hosting and then migrate.","text_addYourWebsiteLimit":"Connected websites limit exceeded.","text_migrate":"Migrate","text_migrateAgain":"Migrate Again","text_migrateLoadingMessage":"<div>A Copy of Your Website <br/>is Being Automatically Created</div><span>Depending on the size of your website, processing may take a little while. You will be notified via email as soon as your website is ready</span>","text_migrating":"Migrate your site to 10Web cloud hosting with just a few clicks. <a class=\'db-link db-more-info-link\' href=\'https://10web.io/blog/how-do-i-migrate-my-wordpress-website-to-10web/\' target=\'_blank\'>Learn more</a>","text_changeBillingCycle":"Change billing cycle","text_activateSubscription":"Activate subscription","text_unpauseSubscription":"Unpause subscription","text_activateSubscriptionLTDAdditional":"Activate Automated WP Hosting Subscription","text_renewSubscriptionLTDAdditional":"Renew Automated WP Hosting Subscription","text_CancelSubscriptionLTDAdditional":"Cancel Automated WP Hosting Subscription","text_save":"save {{percent}}%","text_addWebsiteLogin":"Please enter a valid username.","text_addWebsitePassword":"Please enter a valid password.","text_addWebsiteDomain":"Please enter a valid domain.","text_addWebsiteWatchVideo":"WATCH VIDEO","text_cycleData":"Pay 6 Months ( ${{price}} / every 6 months )","text_cycleDataInactive":"Pay 6 Months","text_payNow":"Pay now","text_payNowTotal":"Total","text_noMoneyUntilUpgrade":"No money will be charged until you upgrade.","text_emptyOptimizedImages":"No optimized images","text_successfullySaved":"Successfully saved","text_proratedCredit":"Prorated credit","text_proratedCreditDesc":"Prorated credit is generated in case of a plan upgrade. When the customer upgrades his/her plan in the middle of a billing cycle, they are only charged for the time they have used 10Web services, rather than for a complete billing cycle. For ex. if a customer decides to switch to a higher plan before their billing cycle expires, they receive a credit for the unused portion of the old plan and are billed for only the remainder of the new plan.","text_everySingleMonth":"Every month","text_userSummariesStarter":"Upgrade now and keep enjoying your super fast website!","text_userSummariesBackupTitle":"Backup storage","text_userSummariesBackupText":"For all websites.","text_userSummariesIoTitle":"Image Optimization","text_userSummariesIoText":"Per month for all websites.","text_userSummariesHostingBlockTitle":"Hosting Resources","text_userSummariesHostingText":"Hosted websites: {{out}} out of {{of}}","text_userSummariesHostingVisits":"Visitors <span class=\'used_visits\'>{{visits}}</span> out of <span>{{totalVisits}}</span>","text_userSummariesHostingStorage":"Storage <span class=\'used_storage\'>{{storage}}</span> out of <span>{{totalStorage}}</span>","text_userSummariesAiGenerations":"Website generations <span class=\'used_gens\'>{{usedCount}}</span> out of <span>{{totalCount}}</span>","text_HostingDatabaseStorage":"<span class=\'sl-hosting-resource-storage-database\'>{{storage}}</span> Database","text_HostingFilesStorage":"<span class=\'sl-hosting-resource-storage-files\'>{{storage}}</span> Files","text_HostingTotalVisits":"<span class=\'sl-hosting-visit-count\'>{{visits}}</span><br/> Visitors","text_HostingTotalStorage":"Total <span>{{storage}}</span>","text_HostingTotalStorageByWebsite":"<span class=\'sl-hosting-resource-storage-total\'>{{storage}}</span><br/>Total","text_seoWidgetInactiveDesc":"Optimize your website content<br/>and structure to rank higher.","text_backupWidgetInactiveDesc":"Schedule automatic real-time backups<br/>for your content, database, and files.","text_optimization":"Image Optimizer","text_optimizerWidgetInactiveDesc":"Start scanning for vulnerabilities and suspicious <br>file changes to safeguard your website.","text_performanceWidgetInactiveDesc":"Start testing and analyzing your website performance.","text_performanceGrade":"performance grade","text_performancePageLoadTime":"page load time","text_performanceTotalPageSize":"total page size","text_updates":"Plugins & themes","text_updateAll":"Update All","text_pluginsUpdate":"Plugins","text_themesUpdate":"Themes","text_wordpressCoreUpdate":"WordPress Update","text_wordpress":"WordPress {{version}}","text_currentVersionWithVersion":"Current version {{version}}","text_updatePlugin":"Update plugins","text_confirmUpdate":"Are you sure you want to update","text_confirmUpdateAll":"Are you sure you want to update all selected plugins","text_wordpressUpToDate":"Your WordPress is up to date.","text_hosting.title":"Hosting services","text_hosting.info":"Credentials","text_hosting.domains":"Domains","text_hosting.domainNotPointed":"Point Domain","text_hosting.resource-usage":"Resource usage","text_hosting.visit-analytics":"Site Visits","text_hosting.tools":"Tools","text_hosting.redirects":"Redirects","text_hosting.removeRedirects":"Remove Redirects","text_hosting.cdn":"CDN","text_hosting.logs":"Logs","text_hosting.manage_environment":"Manage environment","text_hosting.restore":"Restore points","text_removeDemoWebsite":"Remove website","text_removeDemoWebsiteBtn":"Remove","text_removeDemoWebsiteDesc":"By removing your website you will lose full access to<br/> 10Web dashboard and won\u2019t be able to edit your website.","text_removeWebsite":"Do you want to remove your website?","text_removeMultiWebsite":"Do you want to remove your multisite?","text_typeRemoveWebsiteMakePrimary":"To make your domain primary, please enter your password","text_typeRemoveWebsiteMakePrimaryTrials":"To make your domain primary, please enter \'REMOVE\'","text_typeRemoveWebsite":"To remove your website, please enter your password","text_typeRemoveMultiWebsite":"To remove your multisite, please enter your password","text_hostedWebsiteAfterRemoveWillLost":"Be careful! Removing your website from the dashboard will result in:","text_hostedMultiWebsiteAfterRemoveWillLost":"Be careful! Removing your multisite from the dashboard will result in:","text_areYouSureToRemove1":"Be careful! When you remove your website from the dashboard, you will not be able to:","text_areYouSureToRemove2":"Be careful! When you remove your multisite from the dashboard,<br/> you will not be able to:","text_imageOptimizationLimit":"Image optimization limit","text_imageOptimizationLimitNumber":"You have almost reached your plan\'s optimization limit. <br>You can optimize <span>{{canOptimize}} {{optimizableImages}}</span> of selected <span>{{selectedImages}} {{images}}.</span>","text_yesOptimize":"yes, optimize","text_backupLimit":"Backup cloud limit","text_backupNumber":"You have almost reached your plan\'s backup cloud limit. <br>To make more backups you need do upgrade your plan.","text_yesRemove":"Yes, Remove","text_environmentType":"<span class=\'capitalize\'>{{type}}</span> <span>environment</span>","text_hostingBasicInfoLocation":"Location / Data center","text_hostingBasicInfoIp":"IPv4 address","text_hostingBasicInfoIp6":"IPv6 address","text_hostingBasicInfoPath":"Path","text_hostingBasicInfoExternalIp":"Current External IP Address","text_hostingSftpHost":"SFTP host","text_hostingSftpUsername":"SFTP username","text_hostingSftpPassword":"SFTP password","text_hostingSftpPort":"SFTP port","text_hostingDatabaseName":"Database name","text_hostingDatabaseUsername":"Database username","text_hostingDatabasePassword":"Database password","text_hostingDatabaseSftp":"Generate new SFTP password","text_hostingDatabaseButton":"Open MySQL","text_hostingBasicInfoTitle":"Datacenter & IP","text_hostingSftpTitle":"SFTP","text_hostingDatabaseTitle":"Database access","text_hostingSSHTitle":"SSH connections","text_hostingSSHDesc":"Use the following command in the terminal<br class=\'ds-hide-mobile\'> to connect to your site via SSH","text_hostingSSHPassword":"SSH password","text_hostingSSHCommandLine":"Command line","text_environment":"{{environment}}","text_liveChangesDesc":"Changes made here will affect your live website.","text_stagingChangesDesc":"Test all changes before pushing your website to live\u2024","text_hostingPushToLive":"Push to live","text_hostingPushStagingToLive":"Push staging to live","text_hostingPushToLiveDescription":"Pushing to live will overwrite your live site. We\u2019ll create a backup for you just in case.","text_hostingSyncWithLive":"Sync with live","text_hostingSyncStagingWithLive":"Sync staging with live","text_hostingSyncStagingWithLiveDescription":"Syncing with live will overwrite your staging site.","text_hostingSyncWithLiveDialogHeader":"Sync with Live","text_hostingSyncWithLiveDialogMessage":"<span>Attention:</span> Are you sure you want to copy your live website to the staging environment and overwrite your current staging site? Depending on the size of your website, syncing may take a few minutes.","text_hostingDomainsDescription":"Your primary domain is the way we refer to this site and should usually be set to the main domain you would like your visitors to arrive though. The DNS records for the primary domain must be set up correctly for it to work.","text_copied":"Copied","text_copy":"Copy","text_proceed":"Proceed","text_startFromBooster":"Start","test_syncToLive":"Sync With Live","text_confirmGenerateSftpPassword":"Please note that after generating the new password the old password will expire.","text_generateSftpPassword":"Generate new SFTP password","text_generateMySqlPassword":"Generate New MySQL password","text_generate":"generate","text_confirmSubdomain":"Enter \u201c{{siteUrl}}\u201d","text_domainNameWrong":"Site name does not exist","text_domainNameWrongValidation":"Please fill correct site name.","text_pushStagingEnvironmentLive":"Push Staging Environment Live","text_pushStagingConfirmDesc1":"<span class=\'danger\'>Attention:</span> By clicking on proceed, your staging site will be copied to the live environment and will overwrite your current live site. Depending on the size of your website, this process may take a few minutes. <br/>A backup of your live site will be made before pushing the staging<br> site to production.","text_pushStagingConfirmDesc2":"When you push your staging site to live, all the <span class=\'sl-website-link\'>{{websiteLink}}</span> URLs will be changed to your primary domain\u2019s - <span>{{domainName}}</span> - URLs. Click here if you need to change your primary domain.","text_pushStagingConfirmDesc3":"We\u2019ll backup your live site before pushing the staging to production, in case you need to restore the older version of your site.","text_pushStagingConfirmDesc4":"In case you want to proceed, type your site\'s name in the field below, then click on the Push To Live button.","text_pushToLiveInfoTooltipDesc":"When you\'ve made all the changes in your staging environment, it\'s time to push the changes to live. Pushing your staging environment to live means that your staging site will be copied to the live environment and will overwrite your current live site.","text_getMoreInfo":"Get more info","text_credentials.IP.desc":"Your datacenter should be close to most of your website visitors","text_credentials.Database.Desc":"10Web uses the most optimized version of MySQL for your WordPress. You have full access to your website database.","text_credentials.SSH.Desc":"SSH( Secure Socket Shell), is a network protocol that gives you a secure way to access a website over an unsecured network. SSH provides strong password authentication and public key authentication, as well as encrypted data communications between your computer and website connecting over the public internet.","text_howToUseSftpInfoTooltipTitle":"How to use SFTP","text_howToUseSftpInfoTooltipDesc":"SFTP(Secure File Transfer Protocol) is a secure file transfer protocol. SFTP has pretty much-replaced legacy FTP.","text_howToUseSftpInfoTooltipDescShort":"SFTP or Secure File Transfer Protocol is a network protocol used for file transfers. It is a more secure method vs standard FTP.","text_howToUseDbInfoTooltipDescShort":"Database access provides credentials for MySQL database including name, username and password.","text_invalidUsername":"Please enter a valid username.","text_dialogStep":"Step {{step}}","text_installWebsiteDialogDesc":"Install a brand new WordPress website","text_installAdditionalHostedSites":"Additional Hosted Sites","text_installWebsiteDialogTitle":"Subdomain","text_installSubWebsiteDialogTitle":"SITE ADDRESS (URL)","text_installSubWebsiteDialogDesc":"Only lowercase letters (a-z), numbers, and hyphens are allowed.","text_installSubWebsiteDialogInformation":"A new user will be created if the above email address is not in the database.<br/>The username and a link to set the password will be mailed to this email address.","text_autoMigrate":"Automatic Migration","text_autoMigrateDesc":"With 10Web you won\u2019t lose any time migrating your site. We have built a fully <strong>automated migration</strong> service, so you can get your website on <strong>10Web hosting</strong> in minutes. We\u2019ll assign a temporary domain to your migrated site, so you can make <strong>performance comparisons</strong> with your current hosting and ultimately move to 10Web. Read our article on how to migrate your site <a href=\'http://10web.io/cloud-hosting/\' target=\'_blank\'>here</a>.","text_domainWithTitle":"Domain","text_domainWithDescription":"Add your domain if you already have one or add it later on.","text_regionDescription":"Choose location/data center","text_regionDescriptionOther":"Please choose datacenter for your website","text_siteLanguage":"SITE LANGUAGE","text_domainCheckboxDescription":"Automatically add the suitable Zone for this domain.","text_subDomainDescription":"Your site will be accessible at this address by default.","text_regionTooltip":"Choose the location </br>based on your traffic.","text_hostingUrlDescription":"Enter the URL and access details to your hosting panel below.","text_installMultisite":"Should we install multisite?","text_installMultisiteType":"What type of multisite should we install?","text_installMultisiteSubdirectory":"Subdirectory","text_installMultisiteSubdomain":"Subdomain","text_congrats":"Congrats","text_domainAdded":"Domain Added to Your Site","text_installWebsiteDialogSuccessDesc":"Now you have a website on 10Web Automated hosting<br/> powered by Google Cloud. From here on, it gets so much better.","text_installWebsiteDialogSuccessDescWithNameserverScore":"Your super fast website is installed on 10Web Automated WP Hosting","text_installWebsiteDialogSuccessDescWithNameserver":"You just installed your site on 10Web managed hosting powered by Google Cloud.","text_installWebsiteDialogSuccessDescWithNameserverBottom":"Now you have to replace the default nameservers at your<br/> domain registrar with 10Web\u2019s nameservers. <a target=\'_blank\' href=\'https://10web.io/blog/how-do-i-point-my-domain-to-10web/\' class=\'db-link\'><span>Learn More</span></a>","text_installWebsiteDialogSuccessDescWithNameserverTop":"You just installed your site on 10Web hosting.","text_goToWebsite":"go to website","text_nameServers":"nameservers","text_letsAutomate":"Let\u2019s automate the process.","text_addWebsiteDialogDesc":"Please enter your website info below to add it to 10Web dashboard.","text_addWebsiteManuallyDialogTitle":"Connecting Your Website","text_addWebsiteManuallyDialogTitleNew":"Copying Your Website","text_addWebsiteManuallyDialogDesc":"Please follow the steps below. <a href=\'https://10web.io/blog/how-to-connect-your-website-to-10web/?_ga=2.123594702.414440633.1555651362-887026015.1532949577#manual\' target=\'_blank\' class=\'db-link\'><span>Learn more</span></a>","text_addWebsiteManuallyDialogStep1Desc":"Download the plugin below.","text_addWebsiteManuallyDialogStep2Desc":"","text_addWebsiteManuallyDialogStep3Desc":"And activate it.","text_addWebsiteManuallyDialogStep4Desc":"Use your 10Web credentials to log into the plugin. ","text_addWebsiteManuallyDialogStep5Desc":"Come back to 10Web dashboard to start using our services!","text_addWebsiteAutomaticallyDesc":"Just tell us your website\u2019s URL, username, and password and you\u2019re set.","text_addWebsiteManuallyDesc":"In case you sure know how to install a plugin on your own.","text_domainsShort":"Domains","text_hostingDomainsManagePrimaryDesc":"The primary domain is the main address for your site.<br/>Set it to the domain you would like your visitors to arrive through.<br/>Please make sure the DNS records for the primary domain are correct.","text_hostingDomainsManageDNS":"manage dns","text_hostingDomainsManageAll":"manage all","text_hostingDomainsManagePrimaryTitle":"primary domain","text_hostingDomainsManageAllDesc":"Your primary domain is the way we refer to this site and should usually be set to the main domain you would like your visitors to arrive though. The DNS records for the primary domain must be set up correctly for it to work.","text_hostingDomainsAdditionalDomainsTitle":"additional domains","text_hostingDomainsAdditionalDomainsDesc":"Point your other domains to 10Web hosting.<br/>Please make sure the DNS records for additional domains are set up correctly.","text_hostingDomainsAddDomain":"add domain","text_manageDnsShort":"Manage DNS","text_makePrimary":"Make Primary","text_confirmDomainNameRemove.header":"Remove domain","text_confirmZoneRemove.header":"Remove zone","text_confirmMakePrimary.header":"Change of primary domain","text_confirmDomainNameRemove.message":"Your site will no longer be accessible through <b>{{domainName}}.</b><br/> It will still be accessible through your other domains.","text_confirmDomainNameRemove.cdnMessage":"Cloudflare integration for this domain will be automatically disabled after removal.","text_confirmZoneRemove.message":"Your site will no longer be accessible through this zone.","text_confirmMakePrimary.message":"<b>{{domainName}}</b> will become your primary domain, the main address for your site.","text_confirmMakePrimaryNotPointed.message":"Changing the primary domain without pointing <b>{{domainName}}</b> to 10Web is not recommended. Please make sure that DNS records for your site are configured correctly.","text_confirmMakePrimaryNotPointed.message1WF":"Changing the primary domain without pointing <b>{{domainName}}</b> to 10Web is not allowed. Please make sure that DNS records for your site are configured correctly.","text_confirmMakePrimary.button":"Confirm","text_addDomainDesc":"Point your domain to set it as a URL people can use to visit your website.","text_addZoneDesc":"Add a domain name to manage via 10Web DNS. Once a domain has been added we\u2019ll generate Amazon Route 53 Nameservers for it and you can start adding zone records.","text_addDomainTitle":"Add a domain","text_tools":"Tools","text_clearSiteCache":"Website cache","text_clearSiteObCache":"Object cache","text_enableClearCacheDesc":"Use caching to improve website load times <br class=\'ds-hide-mobile\'>by storing server responses for faster access and reduced server load.","text_enableClearObCacheDesc":"Enhance website performance by caching <br class=\'ds-hide-mobile\'>frequent, resource-intensive database queries, reducing access times and server load.","text_enableHttps":"SSL certificates","text_enableHttpsDesc":"Generate a free SSL or add your custom certificate.<br/>Free SSL certificates are generated using the <a target=\'_blank\' href=\'https://letsencrypt.org/\' class=\'ds-link-blue\'><span>Letsencrypt</span></a> service.","text_enableHttpsDescTrial":"To generate a free SSL or add your custom certificate, please point your domain to 10Web.<br/>Free SSL certificates are generated using the <a target=\'_blank\' href=\'https://letsencrypt.org/\' class=\'ds-link-blue\'><span>Letsencrypt</span></a> service.","text_phpEngine":"PHP version","text_phpEngineDesc":"You can change the version of the PHP here.The latest versions of PHP have better performance.","text_restartPhp":"Restart PHP","text_restartPhpDesc":"Here you can restart the PHP.<br> This action is useful when you get PHP crashes or 502 Bad Gateway errors.","text_phpConfig":"PHP configuration settings","text_phpConfigDesc":"Adjust the parameters below according to your needs, up to triple the default limits.<br> These settings help you fine-tune performance and resource usage for your application.","text_changeMainDomainExtension":"Change Main Domain Extension","text_changeMainDomain":"Change Main Domain","text_changeMainDomainDesc":"Modify your website\'s subdomain\'s domain extension, provided by 10Web","text_clearCache":"Clear Cache","text_clearObCache":"Clear Cache","text_clearCacheDesc":"Completely clear your website\u2019s server-side cache. <br class=\'ds-hide-mobile\'>Pages will be cached again after the first visitor opens them.","text_clearObCacheDesc":"Completely clear your website\u2019s object cache. <br class=\'ds-hide-mobile\'>Cached data will refresh with new queries after clearing.","text_changePhpEngine":"Change PHP Version","text_confirmRecordRemove.message":"Are you sure you want to remove record?","text_confirmRecordRemove.header":"Remove Record","text_redirects":"URL Redirects","text_addRedirect":"Add a Redirect","text_updateRedirect":"Update Redirect","text_redirectTo":"redirect to","text_redirectFrom":"redirect from","text_statusCode":"status code","text_confirmRedirectRemove.message":"Are you sure you want to delete this rule?","text_confirmRedirectRemove.header":"Delete Redirect Rule","text_bulkImport":"Bulk Import","text_exportCsv":"Export to CSV","text_uploadCsv.message":"Upload a CSV file. The CSV should have the following fields separated by commas:  status code(301 or  302), domain (all for all domains), redirect from URL, redirect to URL. Each redirect rule should be placed on a new line.","text_uploadCsv.header":"Import URL Redirects","text_emptyRedirectsTable":"There is no redirect rules","text_unavailablePluginDownload.bundleTitle":"Your Site is Unavailable Right Now","text_unavailablePluginDownload.installFailedTitle":"Product Installation Failed","text_unavailablePluginDownload.bundleDescription":"<div>Contact our customer care <a class=\'db-link\' (click)=\'contactUs()\'>here</a> to get it fixed ASAP.</div> <div>In the meantime, you can <a class=\'db-link\' (click)=\'downloadList()\'>download</a> the premium product(s) you purchased here.</div>","text_refresh":"Refresh","text_websiteUnavailable":"<span>Website is unavailable</span>","text_websiteDemoFlowNotFinish":"You didnt finish your website setup","text_websiteDemoCompleteSetup":"Complete Your Site Setup","text_websiteDemoCompleteSetupProgress":"We\u2019re preparing your site ...","text_importRedirects":"import redirects","text_hostingEmptyLogs":"There are no logs","text_cloud_hosting":"10Web Cloud Hosting","text_security":"Security","text_noSecurity":"Protect your website from vulnerabilities<br/>and suspicious file changes.","text_runScan":"Run Scan","text_hostingRestorePoints":"We automatically backup your site every day and before specific important actions. We keep up to 10 restore points with a limit of 20 GB.<br/> To allow for more restore points, please enable the Backup services.","text_hostingEmptyRestores":"There are no restore points.","text_emptyRedirectsTitle":"Add URL Redirect","text_editRedirectsTitle":"Edit Redirect Rule","text_emptyRedirectsHeader":"Hi 10Webber!","text_emptyRedirectsDesc":"URL Redirects (forwarding), is a technique for making a<br/>web page available under more than one URL address.<br/>Add redirect rules to avoid error pages and duplicates.","text_invalidRedirectFrom":"Please fill valid value","text_done_short":"Done","text_resource_usage":"Resource Usage","text_addWebsiteDialogAutoFaq1":"Why do we need your credentials?","text_addWebsiteDialogAutoAnswer1":"We need your credentials to install 10Web Manager plugin on your WordPress to connect your site to our unified dashboard from which you can manage literally everything with more ease and convenience.","text_addWebsiteDialogAutoFaq2":"Why is it secure to share them?","text_addWebsiteDialogAutoAnswer2":"10Web is powered by HTTPS protocol which means all your data is encrypted to ensure your privacy and security.<br/><br/>10Web Manager plugin is  hosted in the WordPress plugin directory, which means it complies with all the WP standards of security.<br/><br/>Thousands of users have already trusted us with their info and we have definitely not let them down. ","text_addWebsiteDialogAutoFaq3":"Why do I need to install 10Web Manager plugin?","text_addWebsiteDialogAutoAnswer3":"Because the connection between your site and 10Web dashboard is established through 10Web manager plugin.","text_wordpressInstallationSiteTitle":"SITE TITLE","text_wordpressInstallationSiteTitlePlaceholder":"Jim\'s blog","text_wordpressInstallationAdminUserName":"ADMIN USERNAME","text_wordpressInstallationAdminPassword":"ADMIN PASSWORD","text_wordpressInstallationAdminEmailTrial":"ADMIN EMAIL","text_wordpressInstallationAdminUserNameTrial":"WP ADMIN USERNAME","text_wordpressInstallationAdminPasswordTrial":"WP ADMIN PASSWORD","text_wordpressPasswordGenerateDescription":"You will need this password to log in. Please store it in a secure location.","text_wordpressInstallation":"WordPress installation","text_wordpressInstallationDesc":"Please provide the following information.","text_hostingRestorePointConfirmDesc":"Are you sure you want to restore this version of the website?","text_redirectInfo":"Redirect is a technique used to redirect your domain\'s visitors from one URL to another.  Redirects are most commonly used when you\u2019re making changes across your website and want to prevent users seeing 404 error pages. <br/>There are 2 main types of redirects: 301 (permanent) and 302 (temporary). You can manage all your redirects below. ","text_deleteDomain":"delete this domain","text_deleteZone":"delete this zone","text_deleteDomainTitle":"DELETE DOMAIN","text_deleteZoneTitle":"Delete zone","text_deleteZoneDesc":"Be aware that deleting this zone will remove its nameservers.<br> Your website won\u2019t be deleted, but it won\u2019t be reachable through this domain anymore.","text_addDomainShort":"add domain","text_addZoneShort":"add zone","text_addDomainDnsTitle":"10Web DNS zones","text_addDomainDnsDesc":"You have reached the domain limit included in your current plan.<br/> With each plan you can have as many domains as WordPress installs. To use more domains upgrade to a larger plan.","text_addZoneDnsDesc":"10Web DNS is a premium Amazon Route 53 DNS service provided to our customers for free.<br> It allows you to manage your own zone records and ensure a faster domain name resolving experience.","text_addZoneDnsExceededDesc":"You have reached the 10Web DNS domain limit included in your current plan. To add more domains contact our  <a target=\'_blank\' href=\'https://10web.io/contact-us/\'>Customer care team.</a>","text_addZoneDomainHint":"Domain name","text_zoneLimitExceededTitle":"DNS zone limit exceeded","text_zoneLimitExceededDesc":"Your DNS zone limit exceeded. You\'ll need to point domain to 10Web with A record or manage your DNS zones.<a class=\'db-link\' [routerLink]=\\"[\'manage-all-dns\']\\">Here you can manage your zones</a>. ","text_upgradeToUseFeature":"To use this feature, please <a [routerLink]=\\"[\'upgrade-plan\']\\" class=\\"db-link\\"><span>Upgrade</span>","text_contactToOwnerUseFeature":"This feature is available to paid plans.<br/>Please contact the workspace owner.","text_zoneCreateProblemTitle":"Problem with DNS Zone","text_zoneCreateProblemDesc":"Your domain has a problem with this DNS zone. It\'s possible that a DNS zone already exists for this domain. You can <a class=\'db-link\' href=\'https://10web.io/blog/how-do-i-point-my-domain-to-10web/#option_2_arecord\' target=\'_blank\'>point domain to 10Web</a> with a record or<a class=\'db-link\' href=\'\' target=\'_blank\'>contact our support</a>, so we can solve the issue.","text_addDomainDnsMXContent":"Add record: MX content","text_addDomainDnsSPFContent":"Add record: SPF content","text_addDomainDnsTxtContent":"Add record: Text content","text_addDomainDnsNsContent":"Add record: NS content","text_addDomainDnsSrvContent":"Add record: SRV content","text_domainName":"DOMAIN NAME","text_addDomainDnsSrvName":"Add Record: SRV name","text_congratsFromManager":"Congrats!","text_congratsFromManagerDesc":"Your site is successfully connected to 10Web dashboard. <br/>You can now activate and start using 10Web services, like Backup,<br/> SEO as well as plugins and themes.","text_congratsFromManagerChallenge":"Your website is connected","text_congratsFromManagerChallengeDesc":"Your Website Copy with<br> Super Fast Load Time Is on Its Way.","text_congratsFromManagerChallengeButton":"Send \\"Yes\\"","text_congratsFromManagerChallengeDescMagic":"Check Your Email in 24 Hours & Watch the Magic Happen!","text_congratsFromManagerPremiumPlugin":"Your {{premiumPlugin}} premium plugin<br/> is now installed & activated!","text_congratsFromManagerBundle":"Your bundle premium plugin is now installed & activated!","text_upgradeNow":"CHOOSE PLAN","text_billedSpecialDesc":"You\'ll pay ${{price}} each month once your free trial ends until you cancel.","text_billedDesc":"You\'ll pay ${{price}} each month once your free period ends until you cancel.","text_upgradePlatform":"upgrade platform","text_10componentsDesc":"10Web is your all-in one platform for building and managing your WordPress website. All your essential WordPress needs- from cloud hosting to page builder, 50+ premium plugins to tons of beautiful templates-are covered.","text_platform":"10Web Platform","text_bundle":"plugins bundle","text_upgradeBundleHeaderTitle":"50+ Premium Plugin Bundle to create a great website","text_upgradeBundleHeaderDesc":"50+ essential premium plugins for creating a dynamic multi-functional WordPress website packed in one beautiful big bundle.","text_serviceCantActivatePhpVersion":"Service can\'t activate with php version < 5.5","hostingManageEnvironment.disableHeader":"Disable staging environment","hostingMangeEnvironment.disableInfo":"Click the button below to disable staging environment.<br>Note that this will remove all changes made in this environment.","hostingMangeEnvironment.disableDialogHeader":"Disable staging environment","hostingMangeEnvironment.disableDialogMessage":"All changes made in staging will be lost\u2024","common.disable":"Disable","link_text_redirects.howToUse.header":"Redirects rule","link_text_redirects.howToUse.body":"Redirects are most commonly used when you\u2019re making changes across your website and want to prevent users seeing 404 error pages. There are 2 main types of redirects: 301 (permanent) and 302 (temporary). Add redirect rules to avoid error pages and duplicates.","link_text_performance.howToUse.header":"How to Use","link_text_performance.howToUse.body":"Check your performance and get useful optimization tips.","link_text_security.howToUse.header":"How to Use","link_text_security.howToUse.body":"Scan your website to discover vulnerabilities and suspicious file changes.","link_text_seoOverview.howToSetup.header":"How to Setup","link_text_seoOverview.howToSetup.body":"Authenticate and get Google Search Console reports.","link_text_seoSearchAnalytics.howToSetup.header":"How to use in the dashboard","link_text_seoSearchAnalytics.howToSetup.body":"Check your SEO reports and track your Search Analytics.","link_text_seoSearchConsole.howToSetup.header":"How to use in the dashboard","link_text_seoSearchConsole.howToSetup.body":"Check your SEO reports and track your Search Console.","link_text_optimizer.howToOptimize.body":"Choose a compression mode and easily optimize your images. Perform automatic optimization\xa0 once the images are uploaded.","link_text_optimizer.howToOptimize.header":"How to optimize images","link_text_backup.howToBackup.body":"Perform fast backups and easily restore your website. Backup manually or schedule automatic backups.","link_text_backup.howToBackup.header":"How to backup","link_text_plugins.howToInstallPlugin.body":"Manage your plugins and get new premium plugins.","link_text_plugins.howToInstallPlugin.header":"How to install a plugin","tooltip_text_notifications":"Notifications","tooltip_text_userSummary":"Usage summary","tooltip_text_actionManager":"Progress indicator","tooltip_text_activity":"Activities","tooltip_text_refer_friends":"Refer Friends","tooltip_text_overview.backup.widget.header":"Backup","tooltip_text_overview.backup.widget.body":"<ul><li><p>Schedule automatic backups.</p></li><li><p>Use differential backup to save only the latest changes.</p></li><li><p>Save backups in secure Amazon S3 cloud storage.</p></li><li><p>Restore website in a click.</p></li></ul>","tooltip_text_overview.performance.widget.header":"Performance","tooltip_text_overview.performance.widget.body":"<ul><li><p>Test your website\'s load time.</p></li><li><p>Find speed issues.</p></li><li><p>Get useful optimization tips for performance boost.</p></li></ul>","tooltip_text_overview.optimizer.widget.header":"Image Optimization","tooltip_text_overview.optimizer.widget.body":"<ul><li><p>Automatically compress all your images.</li><li><p>View optimization reports.</p></li></ul>","tooltip_text_overview.seo.widget.header":"SEO","tooltip_text_overview.seo.widget.body":"<ul><li><p>Add meta information and SEO configurations for each post or page.</p></li><li><p>Generate and customize an XML sitemap.</p></li><li><p>Receive SEO tips to rank higher on Google.</p></li><li><p>Easily track keywords\' rankings.</p></li></ul>","tooltip_text_overview.wpcore.widget.header":"WordPress Core Update","tooltip_text_overview.wpcore.widget.body":"<ul><li><p>Update WordPress core.</p></li></ul>","tooltip_text_overview.resourceUsage.widget.header":"Resource Usage","tooltip_text_overview.resourceUsage.widget.title":"Usage Summary:","tooltip_text_overview.resourceUsage.widget.body":"Monthly website visits and storage used.","text_addWebsiteHeaderIO":"Connect Your Website to 10Web Dashboard<br/> to Optimize Your Images","text_addWebsiteHeaderSecurity":"Connect Your Website to 10Web Dashboard<br/> to Protect your website","text_addWebsiteHeaderBackup":"Connect Your Website to 10Web Dashboard<br/> to Backup your website","text_addWebsiteHeaderPerformance":"Connect Your Website to 10Web Dashboard<br/> to Check your website speed","text_addWebsiteHeaderPremiumPlugin":"Connect Your Website to 10Web Dashboard to:","text_addWebsiteHeaderSeo":"Connect Your Website to 10Web Dashboard<br/> to SEO your website","text_addWebsiteHeader":"Connect your website to 10Web dashboard<br/> to install Premium Plugins","text_addWebsiteWelcome":"Welcome to 10Web","text_addWebsitePremiumPluginStep1":"Get your {{premiumPlugin}}<br/> Premium Plugin with a single click","text_addWebsitePremiumPluginStep1Speed":"Get your Speed Optimization<br/> plugin & optimize your website","text_addWebsitePremiumPluginStep1Bundle":"Get your Premium Plugin Bundle<br/> with a single click","text_addWebsitePremiumPluginStep2":"Get updates for<br/> your plugins automatically","text_addWebsitePremiumPluginStep3":"Get the priority<br/> support you<br/> deserve","text_addWebsitePremiumPluginStep3First":"Get Backup &<br/> Image Optimization","text_addWebsitePremiumPluginStep3Last":"Services for FREE","text_addWebsitePremiumPluginConnectTitle":"How to Connect Your Website to 10Web?","text_addWebsitePremiumPluginConnectDesc":"Go to your WP dashboard Plugins, click Add New, search for<br/> 10Web Manager, and click Install Now.","text_addWebsiteStep1":"Install Manager Plugin","text_addWebsiteStep1Desc":"Go to your WP dashboard Plugins, click Add New, search for 10Web Manager, and click Install Now.","text_addWebsiteStep2":"Connect your website to 10Web","text_addWebsiteStep2Desc":"Go to 10Web Manager in your WP dashboard, and click Connect","text_addWebsiteStep3":"Install your Premium Plugin","text_builderPageTitle":"Website Templates","text_builderPageDesc1":"Choose Your Template & Start Building Your Website","text_builderPageDescWithLast":"Import Another Template","text_builderLastImported":"Your last imported website template","text_scheduleSettingsTitle":"Enter start time and date","text_pluginsBackupSchedulingTitle":"Perform Safe Update","text_pluginsBackupSchedulingDesc":"Enable safe update to backup your website before any scheduled changes","text_pluginsScheduleIncludeExcludeTitle":"Include/Exclude plugins for scheduled updates","selectedProductsForSchedule":"{{selectedProductsCount}} included","text_includeAll":"Include All","text_updateHistoryName":"name","text_updateHistoryDate":"date","text_updateHistoryUpdatedVersion":"updated version","text_productScheduleUpdateExcluded":"Excluded","text_scheduleProductUpdateHistoryEmptyTitle":"No updates were done","text_scheduleProductUpdateHistoryEmptyDesc":"There are no scheduled updates for selected website in this period.","text_themesScheduleIncludeExcludeTitle":"Include/Exclude themes for scheduled updates","text_addWebsiteStep3Desc":"Go to your 10Web dashboard Plugins, click \u201cAdd Plugins\u201d and install premium plugin(s).","text_addWebsiteStep3IO":"Optimize Your Images","text_addWebsiteStep3DescIO":"Go to Image Optimizer, click \u201cOptimize now\u201d and optimize your images up to 90%.","text_addWebsiteStep3Security":"Protect your website","text_addWebsiteStep3DescSecurity":"Go to Security, click \u201cRun Scan\u201d detect and fix security issues.","text_addWebsiteStep3Backup":"Backup your website","text_addWebsiteStep3DescBackup":"Go to Backups, click \u201cBackup Now\u201d and schedule a backup.","text_addWebsiteStep3Performance":"Check your website speed","text_addWebsiteStep3DescPerformance":"Go to Performance, click \u201cCheck Performance,\u201d analyze and improve your website speed.","text_addWebsiteStep3Seo":"SEO your website","text_addWebsiteStep3DescSeo":"Analyze and improve your website SEO and get more organic traffic.","text_paymentInfoTitlePlatform":"Credit card information","text_paymentInfoTitlePlatformDesc":"The credit card you submit now will become your default payment method","text_paymentInfoTitlePlatformDescActivateAccount":"You have no active payment method attached to this account.<br/> To activate the account, please add a payment method.","text_paymentInfoTitlePlatformUsers":"Verify your account with a credit card","text_paymentInfoNoMoney":"No money will be charged.","text_paymentExistingCards":"Existing cards","text_noPaymentMethodDescSubscription":"You need to add a payment method to be able<br/> to continue using our services.","text_addPaymentMethodSubscriptionSuccessTitle":"Congratulations !","text_addPaymentMethodSubscriptionSuccessMessage":"Your plan has been updated and You can start using all the features included right away!","text_addPaymentMethodSubscriptionFailTitle":"Error!","text_addPaymentMethodSubscriptionFailMessage":"Something went wrong! Please recheck all the required fields and submit again!","text_addPaymentMethodSubscriptionFailButton":"TRY AGAIN","text_paymentAddCard":"Add a card","text_domainsExceededTitleDialogAppsumo":"You exceeded the limit of your current plan!","text_domainsExceededDescDialogAppsumo":"An Additional Website will<br/>Cost ${{additionalPrice}}/year","text_domainsExceededDescDialogAppsumoAI":"Get an additional hosted website with $72/year.","text_buyNow":"buy now","text_enableCDN":"Enable","text_howManyAdditionalWebsitesNeed":"How Many Additional Sites You Need?","text_fillOutAdditionalWebsitesNumber":"Fill out the number below","text_addAdditionalWebsiteSuccessMessage":"An additional website has been successfully added!","text_addAdditionalWebsiteMessage":"You have successfully added {{count}}.","text_hostingAddOnForBoosterMessage":"You have successfully purchased<br/> 10Web Hosting add-on for {{number}}.<br/><br/>Migrate your website to 10Web to get all the benefits.","text_hostingAddOnForBoosterMessageFromCreate":"You have successfully purchased<br/> 10Web Hosting add-on for {{number}}.<br/><br/>Start creating your website now.","text_addAdditionalWebsiteAndCdnMessage":"You have successfully added {{siteCount}} and<br/> {{cdnCount}} to your account.","text_addAdditionalWordsMessage":"You have successfully added {{siteCount}}","text_addAdditionalCdnMessage":"You have successfully purchased<br/> Cloudflare Enterprise CDN for {{cdnCount}}.","text_copyLink":"COPY LINK","text_myCredit":"my credit","text_inPending":"Pending","text_referAndEarn":"Get a ${{price}} credit for<br/>successful referrals you make.","text_yourFriendGetCredit":"","text_shareReferral":"Share the referral link with your community.<br/>Give them ${{price}} credit and a chance to improve their website score.","text_applyCredit":"Apply credit","text_leaderBoard.position":"Position","text_leaderBoard.name":"Name","text_leaderBoard.referrals":"Referrals","text_checkout_coupon_error":"This coupon code is invalid or has expired.","text_pluginInstallNotiff":"{{pluginName}} plugin will be installed on your website","text_wpAdminInfoTitle":"Access WordPress Dashboard","text_wpAdminInfoTitleMultisite":"Access Network WordPress Dashboard","text_submitYourIdea":"Submit your idea","text_moveTo10WebMenuTitle":"Speed Up Your Website","text_moveTo10WebMenuTitleHosted":"Get 95+ Score","text_moveTo10WebMenuTitleHostedJoined":"95+ Score","text_moveTo10WebMenuDesc":"Move to 10Web","text_enable2faTitle":"Enable Google 2FA","text_enable2faDesc":"Enable two-factor authentication by scanning the barcode below. Alternatively, you can use the code <span>{{code}}<span>","text_enable2faImageDesc":"You must set up your Google Authentication app before continuing. You will be unable to sign in otherwise.","text_enabled2faTitle":"2FA Enabled","text_disable2faTitle":"Disable Google 2FA","text_disable2faDesc":"Are you sure you want to disable two-factor authentication?","text_disable2faLabelAuthenticator":"Enter a code from the Google Authenticator app","text_disable2faLabelRecovery":"Enter one of your recovery codes","text_disable2faTroubleTitle":"\u0422rouble with your authentication app?","text_disable2faTroubleDesc":"Enter one of your recovery codes.","text_disable2faVerifTitle":"Get a verification code from the","text_disable2faVerifDesc":"Google Authenticator app","text_empty2fa":"2FA token is required","text_login2faTitle":"2-Step Verification","text_login2faDesc":"This extra step shows it\u2019s<br/> really you trying to sign in","text_wpAdminInfoDesc":"Login into WP dashboard by clicking this icon.<br/> Alternatively, you can login from site.com/wp-admin url.","text_wpFrontInfoDesc":"Visit Your Website","text_editDesc":"Edit Your Website","text_tooltipFriendCreditPending":"Your pending credit will be activated as soon as the user you referred upgrades to paid plan.","text_tooltipFriendCredit":"<ul><li><p>Your credit gets activated when a friend you referred completes their registration through your link.</p></li><li><p>You can use your credit by clicking \u201cApply credit\u201d button in the Dashboard.</p></li><li><p>Credits can be used to extend current plan correspondingly and for plan upgrade.</p></li><li><p>Payment method is required for applying the credit.</p></li><li><p>We keep the right to deduct credits upon unfair activities.</p></li></ul>","text_tooltipReferralCredit":"<ul><li><p>Your existing credit must be used when extending or upgrading a plan.</p></li><li><p>The total amount of credit will be applied.</p></li></ul>","text_tooltipAppliedCredit":"Prorated from your previous purchase","text_seoCustomMetadataTitle":"Custom Metadata","text_seoCustomMetadataDesc":"Customize the meta title, meta description, and keywords for each post or set default placeholders. Set up \u201cmeta robots\u201d configurations with tags like \u201cfollow\u201d and \u201cindex\u201d.","text_seoCanonicalTitle":"Canonical Urls","text_seoCanonicalDesc":"In case there\u2019s more than one URL to a single page, add canonical tags to show the search engines that it\u2019s the same page and avoid duplicate content errors.","text_seoXMLTitle":"XML Sitemap","text_seoXMLDesc":"Generate and customize an XML sitemap with no technical knowledge required. Make your website structure and hierarchy of pages clearer to the search engine crawlers.","text_seoSearchAnalyticsTitle":"Search Analytics","text_seoSearchAnalyticsDesc":"See what queries lead users to your website and use them to optimize your content. Get detailed reports filtered by device type. View the clicks, CTR, search position, and more.","text_seoRedirectsTitle":"Redirects","text_seoRedirectsDesc":"Move a page on your site to a new url or fix a broken link by redirecting the old URL to a new page.","text_thirdPartyThemeTitle":"Notice","text_thirdPartyThemeDesc":"You\u2019re about to activate a third party theme unsupported<br/> by the 10Web Builder. By activating, you will disable<br/> the 10Web Builder.","text_tooltipEditWebsite":"Edit With 10WEB Builder","text_tooltipBuildWebsiteHeader":"Build with 10Web Builder","text_upgradePlan":"Upgrade to a Higher Plan","text_upgradePlanPercentOffer":"Special pricing, only this Black Friday","text_upgradePlanStarterHeader":"Your Trial Expires in {{trialDeleteDay}}","text_upgradePlanStarterHeaderSpecialOffer":"Upgrade to 10Web Pro Plans with special discount\\n","text_upgradePlanBuilderTrialHeader":"Your Demo Website Expires In {{trialDeleteDay}}","text_upgradePlanStarterSubHeader":"Upgrade to Continue Using 10Web Platform","text_upgradePlanStarterSubHeaderAiBuilderFlow":"Upgrade to Use 10Web Platform","text_upgradePlanRefHeader":"Buy a Plan Using Your ${{refActiveCredit}} Credit and<br/> Build Your WordPress Website In Just Minutes","text_upgradePlanBundleHeader":"10Web Managed WordPress Hosting","text_upgradePlanStarter":"Great for testing<br> out the platform","text_upgradePlanPremium":"A great deal for a growing <br> business and ecommerce","text_upgradePlanPersonal":"Ideal for a starting business <br> or blog","text_upgradePlanEnterprise":"A powerful deal to take your <br> business to the next level","text_upgradePlanCloseDetails":"CLOSE DETAILS","text_upgradePlanViewDetails":"VIEW DETAILS","text_upgradePlanClosePlanDetails":"HIDE ALL FEATURES","text_upgradePlanViewPlanDetails":"See all features","text_exceededStorageTooltipTitle":"You have exceeded your backup storage limit","text_exceededStorageTooltipDesc":"Learn how the extra storage is charged","text_exceededVisitsTooltipTitle":"You have exceeded your visits limit","text_secureCheckout":"Secure checkout","text_secureCheckoutApiFree":"Sign up & checkout","text_signUp":"Sign up","text_signUpCreateAccount":"Create 10Web Account","text_signUpStartTrial":"Start a {{trialPeriodNumber}}-Day Free Trial","text_tooltipBuildWebsiteDesc":"Edit anything on your website using drag &<br/> drop 10Web builder based on Elementor.","text_exceededVisitsTooltipDesc":"Learn how the extra visits are charged","text_websiteInstallMode":"install mode","text_websiteInstallWebsiteName":"website name","text_websiteInstallWebsiteEnv":"Environment","text_survey-rate":"Please rate migration results","text_requestSent":"Request Sent","text_sadFeedback":"We\u2019re sorry to hear that.","text_sadFeedbackDesc":"Join a slack channel created only for you and our<br/> engineers will help you fix all the issues.","text_happyFeedback":"Thank You for Feedback!","text_joinUsInSlack":"Join us in a Slack channel","text_happyFeedbackDesc":"Join a Slack channel created only for you, where<br/> you can get in touch with our management.","text_requestSentDesc":"We\u2019re happy to invite you to a Slack channel<br/> created only for you, where you can get in<br/> touch with our management","text_survey-notLike":"Least Satisfied","text_survey-extrimLike":"Most Satisfied","text_survey-desc":"How Satisfied are You with<br/> Your Website Migration?","text_survey-receive":"You will receive the invitation soon.<br/> Don\u2019t forget to check your email.","text_nps-header-booster":"Do you enjoy using 10Web Booster?","text_nps-desc-booster":"How likely are you to recommend 10Web Booster <br/>to someone struggling with website speed?","text_nps-header":"How likely is it that you would recommend<br/> 10Web to a friend or colleague?","text_nps-notLike":"Not at all likely","text_nps-extrimLike":"Extremely likely","text_nps-rating-comment":"What should we improve for you in order to give us a higher ranking? <span>(optional):</span>","text_nps-rating-comment-ten":"What do you find most valuable about the 10Web platform?","text_nps-congrats-title":"Thank you for your feedback!","text_nps-congrats-desc":"We are constantly improving 10Web Platform<br/> based on your feedbacks.","text_nps-congrats-review-title":"Thank you for your nice feedback!","text_nps-congrats-review-desc":"Leave a review on G2 Crowd and get a $20 Amazon US Gift Card.","text_manualMigrationSentTitle":"Manual migration request<br/> successfully submitted","text_manualMigrationSentDesc":"Please keep an eye on your inbox. A member of our<br> team will contact you once migration is complete.<br> It can take up to 24 hours.","text_manualMigrationSentDesc2":"You can also request a demo with our top specialist. We will show you your<br class=\'hide-mobile\'/> migrated website & present you everything you need to get the most out of 10Web.","text_mySites":"My sites","text_performanceTestFrom":"TEST FROM","text_multisiteActivate.header":"Activate the plugin","text_multisiteActivate.message":"You can activate the chosen plugin for only this website<br/>or for all the websites in this multisite.","text_multisiteDeactivate.header":"Deactivate the plugin","text_multisiteDeactivate.message":"You can deactivate the chosen plugin for only this website<br/>or for all the websites in this multisite.","text_multisiteAddSiteWithoutPointingDomainBtn":"Point a Domain","text_multisiteAddSiteWithoutPointingDomainTitle":"Point a Domain to Add a New Site","text_multisiteAddSiteWithoutPointingDomainDesc":"To add a new site to your multisite network, first you need to connect your domain to 10Web.","text_googleScoreTitle":"Your Website Template Is Installed.<br/>It\'s Super Fast<img src=\'../../../../../assets/images/emojis/rocket.png\'/>& Has a High Google PageSpeed Score.","text_googleScoreTitle_onboarding":"Your Website Template Is Installed<br/>It\'s Super Fast<img src=\'../../../../../assets/images/emojis/rocket.png\'/>& Has a High PageSpeed Score","text_templateSuccessTitle":"Your Website Template Is Installed","text_templateSuccessDesc":"It\'s Super Fast<img src=\'../../../../../assets/images/emojis/rocket-small.png\'/>& Has a High PageSpeed Score","text_templateSuccessBtn":"Great!","text_templateSuccessBtn_Preview":"Preview Website","text_upgradePlanMonthlyVisitors":"For every 10K extra visitors you\u2019ll be charged an extra $2 at the end of the billing month.","text_upgradePlanSSDStorage":"You\u2019ll be charged an extra $2 at the end of the billing month for each extra 5GB used","text_upgradePlanAdditional":"For more hosted websites,<br> you need to upgrade for a higher plan","text_upgradePlanOneClickMigration":"Automatically move your website to 10Web from any other hosting","text_upgradePlanClientManagement":"Create users and give them different permissions to your account and websites.","text_upgradePlan90PagespeedScore":"Get an automatically optimized copy of your website with a 90+ PageSpeed score.","text_upgradePlanAdditionalBackupHeader":"Additional Backup Storage","text_upgradePlanAdditionalBackupDesc":"20GB additional Backup Storage costs $2","text_nameServerResolving":"When adding the nameserver it can take up to 24 hours to be resolved.","text_choosePlanFromBooster":"Accelerate your business growth by utilizing all of 10Web platform features.","text_choosePlanFromBoosterOffer":"Explore all 10Web Booster Pro features and further improve your website performance.","text_getStartedFromBooster":"Switch to 10Web Booster Pro","text_getStartedFromBoosterOffer":"Get {{days}} days of 10Web Booster Pro for free","text_getStartedFromBoosterPro":"Upgrade to a Higher Plan","text_getStartedFromGallery":"Upgrade to Pro plan","text_getStartedFromGallery_subHeader":"Use premium features, automatically optimize your images and website for a 90+ PageSpeed score.","text_getStartedFromBoosterProSubHeader":"Optimize more websites with 10Web Booster","text_addDnsRecord":"Add DNS Record","text_addGmailRecord":"Add GMAIL MX records","text_addZohoRecord":"Add ZOHO MX Records","text_editDnsRecord":"Edit DNS record","text_addRecord":"Add Record","text_addRecordsTtl":"TTL","text_addRecordsPriority":"Priority","text_addRecordsWeight":"Weight","text_addRecordsPort":"Port","text_addRecordsServerHostName":"SERVER HOST NAME","text_addRecordsServer":"Server","text_addRecordsTxtContent":"TXT content","text_addRecordsSpfContent":"SPF content","text_addRecordsHostname":"Hostname","text_addRecordsMailServer":"Mail server","text_googleSpinnerDesc":"Your Google PageSpeed Score is being analyzed","text_googleSpinnerDescGood":"Wow! Your Google Page SpeedScore is super high!<br/>Click to get more info.","text_googleSpinnerDescBad":"Get Google PageSpeed Score of 95+!<br/> Click to start optimizing.","text_googleSpinnerAdditionalInfoTitle":"Your Desktop Google PageSpeed Score","text_googleSpinnerAdditionalInfo":"Get additional information about your PageSpeed score and how it can be optimized.","text_enable":"Enable","text_googleSpinnerDescError":"Something went wrong \u{1f641}<br/>please click to get more info.","text_whiteLabelAgencyTitle":"White Label is only available in Agency plan","text_whiteLabelLTDTitle":"White label is available only on hosted websites","text_whiteLabelAgencyDesc":"If you want to use the white labeling you need to upgrade.","text_whiteLabelLTDDesc":"Get a hosted website to use white labeling","text_whiteLabel":"White label","text_whiteLabelPersonalizedDb":"10Web platform offers a full WordPress admin white label.","text_whiteLabelActivateTitle":"Select websites to white label","text_whiteLabelActivateDesc":"You can select all websites at once or one by one.","text_whiteLabelCompanyName":"Company Name","text_whiteLabelUploadLogo":"Upload","text_whiteLabelUploadLogoDesc":"Recommended: 256\xd7256px, SVG or transparent PNG.</br>If no logo is uploaded, the \u201c10Web\u201d logo will be used by default.","text_whiteLabelUseDefaultLogo":"Use Default Logo","text_whiteLabelCacheContent":"Cache content","text_whiteLabelNoWebsites":"Seems like you don\u2019t have any websites yet!","text_whiteLabelCacheContentPlaceholder":"We use NGINX FastCGI Static Page Caching to cache everything from pages to feeds to 301-redirects on sub-domains. It helps your site to load super fast for your non-logged-in visitors.","text_passwordProtectionDescDisabled":"Test with 3rd party tools","text_passwordProtectionDescEnabled":"Site is password protected","text_passwordProtectionTitle":"Website Is Password Protected","text_passwordProtectionDescFirstTime":"The website is visible from your IP and you can test the speed with GTmetrix, PageSpeed Insights, and Pingdom. To use any other test tools, please enable Public Visibility.","text_passwordProtectionPreviewWebsite":"PREVIEW WEBSITE","text_passwordProtectionTitleSidebar":"Public Visibility","text_passwordProtectionTitleDisabled":"Public Visibility Enabled For 10 Minutes","text_username":"username","text_passwordProtectionDesc":"Your website is visible from your IP. To give access<br/> to others, share your username and password.","text_passwordProtectionUpgrade":" to permanently remove password protection","text_passwordProtectionEnableTomorrow":"Enable again at the end of 1 hr","text_googleSpinnerAdditionalMore":"learn more","text_referrals":"referrals","text_newFeatures":"NEW FEATURES","text_buyAdditionalBtn":"Buy","text_10webExpertsCommunity":"10Web Experts Community","text_10webExpertsCommunityDesc":"Exclusive updates, huge network","text_buyAdditionalWebsite":"Additional website","text_buyAdditionalWebsiteDesc":"For ${{price}}/{{repeat}}","text_buyAdditionalWebsiteOffer":"Buy +1 Website ${{price}}/mo","text_buyAdditionalWebsiteOfferLTD":"Buy {{num}} Hosted Website for ${{price}}/yr","text_referFriendBLockTitle":"Refer a friend","text_referFriendBLockDesc":"Invite & earn credits","text_referFriendBLockButton":"invite","text_websiteScoreTitle":"Test Any Other Website\u2019s <Br> Speed on 10Web Hosting","text_websiteScoreTitlePlugins":"Test Your Website\u2019s <Br> Speed on 10Web Hosting","text_websiteScoreDesc":"Create a copy of your website with automated <br> migration to get a 90+ PageSpeed score.","text_websiteScoreConnectedDesc":"You\u2019ve done a great job<br/> optimizing your website!","text_websiteScoreHostedTitle":"Your current Google PageSpeed score","text_SSHDescShort":"Secure Shell is a network protocol that gives users a secure way to access a computer over an <br/>unsecured network.","text_seoOverviewAddMetadata":"Add metadata to your posts and pages with 10Web SEO.","text_seoOverviewLearnMoreDesc":"You can also manage canonicals, redirects and XML sitemap.","text_domain.empty.title":"Point Your Domain","text_domain.empty.desc":"Point your domain to 10Web Automated WordPress hosting<br/>to enjoy a super-fast website","text_domain.empty.desc.free":"Upgrade now to connect your custom domain to your super<br/>optimized website on 10Web Automated WordPress hosting.","text_addDomain.success.desc":"Now you have to replace the default nameservers at your domain<br/>registrar with 10Web\'s nameservers.","text_addDomain.nameserver.label":"Nameserver {{number}}","text_addDomain.success.footer":"After adding the 10Web nameserver, it can take up to 24 hours to be resolved and activated.","text_get-pageSpeed-score":"Get 90+ PageSpeed score with complete frontend and backend optimization","text_get-booster-score":"Grow your business with 10Web Booster","text_get-booster-score-desc":"Optimizing your websites with 10Web Booster means:","text_score.check.title":"Check Your Score","text_score.error.desc":"Please check if your website works properly and try again in a day or contact us.","text_score.website.copy":"your super optimized website copy is on its way","text_score.current":"Your Current Google Page Speed Score","text_score.low":"It seems like your website is pretty slow","text_score.low.desc":"Automatically Get a 90+ PageSpeed Score on 10Web Hosting","text_copy.my.website":"copy my website","text_copy.optimize":"copy & optimize my website","text_done.automatically":"It\u2019s Done Automatically","text_achieved_95+":"How We Achieved a 90+ PageSpeed Score","text_page.caching":"Server Side Page Caching(Fast-CGI)","text_css.html.minify":"CSS & HTML Minification & Compression","text_gzip.compression":"Cache Preloading & GZIP Compression","text_js.minification":"JS Minification and Compression","text_db.optimization":"Database Optimization","text_js.css.execution":"Defer JS and CSS Execution","text_dns.prefetching":"DNS Prefetching","text_dns.critical":"Critical CSS Generation","text_lazyload":"Image Lazyload","text_img.to.webp":"Conversion Image Format to WebP","text_iframe.video.lazyload":"iFrame and Video Lazyload","text_img.resizing":"Container-specific Image Resizing","text_woo.optimized":"WooCommerce Optimized","text_low.pagespeed":"If your PageSpeed score is below 90, please","text_one.step.left":"Only One Step Left To Use Your Optimized Website","text_super.fast.hosting.services":"Super Fast Hosting and Services Like Backup, Security, SEO and More","text_move.your.website":"Move Your Website to<br class=\\"db-new-line\\" /> 10Web Automated Hosting","text_new.hosting":"Test the New Hosting Before","text_final.decision":"Making a Final Decision","text_point.domain.tooltip":"Point your domain to set it as a URL people can use to visit your website.","text_tooltip.img.to.webp":"Compression of images up to 34% by converting to WebP format, keeping the size small and the quality rich. This results in a much faster website with great  quality. ","text_tooltip.page.caching":"Allows for the fast load time of web pages by storing request responses.","text_tooltip.css.html.minify":"Minifies and compresses CSS & HTML into lightweight files, having a direct effect  on the load time of your website. ","text_tooltip.gzip.compression":"Preloading website pages warm up the cache and make the website faster. Gzip compression makes files smaller thus reducing the amount of time required to transfer a resource from the server to a browser.","text_tooltip.js.minification":"Minifies and compresses JS files into lightweight files for faster load time and data transfer. ","text_tooltip.db.optimization":"Optimization of a database (MySQL) specifically designed for WordPress websites","text_tooltip.js.css.execution":"Defers the execution of JavaScript and CSS in HTML until page load completes. This gives priority to user experience, by loading the site for your visitors faster and then taking care of the rest for your site to function. ","text_tooltip.img.optimization":"Compression of images of up to 40% without loss of original data and up to 90% without loss of quality. Automatically optimize images upon upload to keep your website running fast and smooth.","text_tooltip.dns.prefetching":"Inserts tags to reduce DNS resolution time.","text_tooltip.dns.critical":"A technique that extracts only the necessary CSS to render website content as soon as possible.","text_tooltip.lazyload":"Loading of images as visitors scroll down the page, improving the load time of your website pages.","text_font.swap":"Font Swap","text_tooltip.font.swap":"To return your visitors queries faster, we display data with a generic font while your font is being fetched. ","text_tooltip.iframe.video.lazyload":"Loads iFrames and videos as visitors scroll down the page, improving load time of your website pages. ","text_tooltip.img.resizing":"Resizing of large images to fit smaller containers while maintaining its aspect ratio. Results in faster loading websites.","text_tooltip.woo.optimized":"As safety of information is top priority, we have made WooCommerce fully compatible with the 10Web cache. No extra configuration is needed. All WooCommerce pages are automatically detected and not cached.","text_moveTo10web.loadTime":"Load Time","text_moveTo10web.showMobileScore":"Show Mobile Score","text_overview.upgradeOffer.title":"Upgrade Now And Get:","text_overview.upgradeOffer.offer1":"Automated WP hosting powered by Google Cloud","text_overview.upgradeOffer.offer1.mobile":"Manged WP hosting powered by GCloud","text_overview.upgradeOffer.offer2":"Use any WordPress theme or plugin","text_overview.upgradeOffer.offer3":"90+ Google PageSpeed score","text_overview.upgradeOffer.offer4":"Website builder based on Elementor","text_overview.upgradeOffer.offer5":"40+ website templates","text_overview.upgradeOffer.offer6":"Backup, security & SEO services","text_overview.upgradeOffer.offer7":"50+ premium plugins","text_overview.upgradeOffer.upgradeNow":"upgrade now","tooltip_text_overview.score.widget.body":"Previously measured PageSpeed score and load time.","tooltip_text_overview.score.widget.header":"PageSpeed Score","tooltip_text_overview.security.widget.body":"Previously scanned number of issues and vulnerabilities.","tooltip_text_overview.security.widget.header":"Security","text_sidebar.users":"Users","text_SubscriptionPlan.TitleTodayExpired":"EXPIRES","tooltip_text_tourSection":"Explore Dashboard","text_ai-builder.title":"AI Builder","text_ai-builder.recreate":"Recreate Website with AI","text_ai-builder.recreate-menu":"Recreate with AI","text_ai-builder.templates":"Templates","text_ai-builder__point1":"Use the AI Builder to recreate any website <br> on WordPress while keeping them fully customizable.","text_ai-builder__point2":"Choose one of our 40+ ready made templates <br> & customize it with 10Web builder based on Elementor","text_ai-builder.add-page":"Add Page","text_ai-builder.add-website-pages":"Add \'{{url}}\' pages for recreation.","text_home_page":"Home Page","text_added-pages-count":"Added pages {{ count }} of 10","text-ai-builder-info-txt":"AI Builder will recreate & import the copy of your website.<br/> Necessary plugins may be installed to achieve correct recreation.","text-ai-builder-editable-header-footer":"If pages have the same header or footer, editable header/footer templates will be created. <br> If pages have different headers or footers, they will become a part of the page content.","text_ai-builder-no-pages":"Insert the homepage URL of the website<br class=\'db-new-line-for-mobile\' /> you want to recreate.","text_ai-builder-recreate":"RECREATE & IMPORT","text_ai-builder-copy-title":"Copy of Your Website is in Progress","text-ai-builder-copy-desc":"Your visual & functional copy will be ready in minutes","text-ai-builder-loading-title":"<span class=\'db-hide\'> Step 1: </span> Recreating","text-ai-builder-loading-desc":"Please wait while we recreate your website.","text-ai-builder-loading-title2":"<span class=\'db-hide\'> Step 2: </span> Importing","text-ai-builder-loading-desc2":"Please wait while we import your copy.","text-aiBuilder-loading-txt":"Creating layout...","text_aiBuilder__step1":"Enter Your Website Link","text_aiBuilder__step2":"Recreate your website with <br> AI on WordPress in minutes","text_aiBuilder__step2-short":"Recreate your website with AI<br/>on WordPress in minutes","text_aiBuilder__step3":"Edit with 10Web Editor based <br> on Elementor","text_aiBuilder__step3-short":"Edit with 10Web Editor based<br/>on Elementor","text_aiBuilder__stepGetStarted":"GET STARTED","text_aiBuilder__stepTitle1":"You\'re 3 Steps Away From Recreating Your Website","text_aiBuilder__stepTitle2":"How It Works","text_aiBuilder__stepDesc":"Take these 3 steps for recreating your website on WordPress","text_aiBuilder__wrong":"Something Went Wrong :/","text_aiBuilder__contact_us":"We encountered an error while recreating your website. <br> Contact our <a target=\'_blank\' href=\'https://10web.io/contact-us/\'> customer care </a> team to get it fixed ASAP.","text_aiBuilder__notice-title":"Notice","text_aiBuilder__notice-desc":"You\u2019re about to activate a third party theme unsupported by the 10Web Builder. By activating, you will disable the 10Web Builder.","text_aiBuilder__notice-title2":"Importing a Recreated Website or a Template","text_aiBuilder__notice-desc2":"You have already imported a recreated website or a website template. A new import of one or the other, will move current posts and the template to trash and you can recover them later on.","text_aiBuilder__notice-desc3":"Importing a recreated website or a website template will change your theme to 10Web default. Though there will be no data loss, we recommend you avoid new imports into a live website.","text_aiBuilder__success":"AI Assistant Recreated Your Website & <br> Saved You Hours of Manual Work.","text_aiBuilder__success-desc":"Explore your newly created website and 10Web features.","text_aiBuilder__success-button":"PREVIEW WEBSITE","text_aiBuilder__success-button-text":"Even if you see a difference between the original website and<br/>recreated website, you can always edit it with Elementor.","text_aiBuilder__getting-started":"Getting Started With AI Builder","text_aiBuilder__get-copy":"Get a copy of your website in minutes using AI Assistance","text_aiBuilder__move-to-wp":"Build Your Website With AI Assistance","text_aiBuilder__move-to-wp-desc":"Get a fully customizable copy of your website on <br/>WP in minutes.","text_aiBuilder__automated":"10Web Website Editor","text_aiBuilder__automated-desc":"Use the 10Web Editor and pro widgets to customize <br> the copy of your website.","text_aiBuilder__rapid":"Build The Best With The Best","text_aiBuilder__rapid-desc":"Take advantage of the 10Web AI Builder, WordPress, <br/>Elementor, and the 10Web hosting infrastructure <br/>powered by Google Cloud all housed under one roof.","text_aiBuilder__DIY":"DIY Website Development","text_aiBuilder__DIY-desc":"Develop your business websites independent of high-cost professionals","text_aiBuilder__nextStep":"NEXT","text_emailVerification.wpadmin":"To access your WordPress admin dashboard,<br/> please check your inbox and verify your email address.","text_emailVerification.phpmyadmin":"To access PhP MyAdmin,<br/> please check your inbox and verify your email address.","text_emailVerification.seo":"To use the SEO service by 10Web,<br/> please check your inbox and verify your email address.","text_emailVerification.users":"To access the Users page of your WordPress dashboard,<br/> please check your inbox and verify your email address.","text_emailVerification.uploadPlugin":"To upload Plugins/Themes, please check your inbox and verify<br/> your email address.","text_emailVerification.title1":"Verify Your Email","text_emailVerification.title2":"A Verification Email<br/> Was Sent to Your Mailbox","text_emailVerification.Desc2":"Please check your inbox to verify your email address","text_emailVerification.successTitle":"Success!","text_emailVerification.successDesc":"Your Account Has Been Verified","text_emailVerification.failedDesc":"Please resend the verification email and verify again.","text_emailVerification.cantFind":"Can\u2019t find the verification email?","text_emailVerification.resendEmail":"Resend it.","text_appsumoHeaderSubTitle":"Introducing The 10Web AI Builder","text_appsumoHeaderTitle":"Special Offer For SumoLings","text_appsumo10WebMessage":"You\u2019ve been utilizing 10Web as your website building and hosting<br/>solution for a while now. How about taking it up a notch! <span class=\'db-message-new-line\'>The AI Builder is the 10Web Builder you\u2019ve been using, enhanced<br/>with AI Assistance. Build websites with more ease and efficiency<br/>using the AI Assistant.</span> We are offering a special Lifetime Deal to our SumoLing family.<br/>Scale your business in a matter of days.<br/>With AI Assistance, the possibilities are limitless!<br/>Keep scrolling to learn more <img src=\'../../assets/images/emojis/wink.png\'/>","text_appsumo10WebMessageMoney":"You can get a plan, test it out, and if you are not satisfied with<br/>the product.","text_appsumo10WebMessageSignature":"10Web Team","text_planItemLtd":"Lifetime Deal","text_planItemLtdOriginalPrice":"Original Price","text_planItemLtdForWebsites":"For {{websiteCount}} Websites","text_planItemLtdLifetimeSupport":"Lifetime Support","text_planItemLtdLifetimeUpdates":"Lifetime Updates","text_haveHostingAdditionalActivate":"activate plan","text_haveHostingAdditionalRenew":"renew plan","text_affiliates":"Affiliate System","text_affiliateLink":"Affiliate Program","text_migration_additional_info":"Are there any special requirements like additional folders, htaccess rules, or Nginx rules that we should consider upon website migration?","text_aiBuilder__enable_now":"The AI Builder: Build Without Limitations","text_ai-builder__point1.title":"Build Your Website With AI","text_ai-builder__point1.desc":"Recreate a visual and functional copy of a website<br/>in minutes.","text_ai-builder__point2.title":"Full Customization","text_ai-builder__point2.desc":"Customize and create beautiful websites with the drag and<br/>drop editor based on Elementor.","text_ai-builder__point3.title":"Build The Best With The Best","text_ai-builder__point3.desc":"An unbeatable combination of tools and services: <br> WordPress, Elementor, and AI builder.","text_ai-builder-trial__title":"Welcome To The AI Builder, <br> The Future Of Website Building ","text_ai-builder-trial__desc":"Start your journey","text_ai-builder-trial__step1":"Enter Website Link","text_ai-builder-trial__step2":"Recreate a Functional Copy on WordPress With AI","text_ai-builder-trial__step3":"Edit With the 10Web Website Editor","text_ltd_connect_website_title":"Recreate with AI Builder on Your Existing Website","text_wb_subscription_plan_point1":"Website optimization","text_wb_subscription_plan_point2":"Full frontend optimization","text_wb_subscription_plan_point3":"Backend speed acceleration","text_ltd_connect_website_desc":"Build your websites with AI Assistance and edit them<br/>with the 10Web Editor based on Elementor.","text_ltd_subscription_plan_point1":"AI Website Builder","text_ltd_subscription_plan_point2":"AI assistant","text_ltd_subscription_plan_point3":"Drag & drop editor based on Elementor","text_ltd_subscription_plan_point4":"30+ pro widgets","text_ltd_subscription_plan_point5":"40+ Ready-made Website Templates","text_ltd_subscription_plan_point6":"Responsive editing","text_ltd_subscription_plan_point7":"WooCommerce builder","text_ltd_subscription_plan_upgrade":"Upgrade To Build More Websites","text_ltd_subscription_plan_hosting":"Automated WordPress Hosting","text_ltd_subscription_plan_desc":"Boost the number of your websites by upgrading to a higher plan","text_ltd_subscription_plan_hosting_desc":"Get Managed WP hosting Powered by Google Cloud<br/>at the fixed price of $72/year","text_builder_trial_upgrade_title":"Get An Exclusive Lifetime Deal","text_builder_trial_upgrade_desc":"Upgrade now to get a Lifetime Deal on the AI Builder. Limited time offer.","text_congratsFromManagerDesc_ltd":"You can now recreate a website using AI Assistance<br/>and edit it with the 10Web Editor.","text_appsumo_subscription_plan_templates":"<b> 40+ </b> Designer Made Templates","text_ltd_connect_website_popup_title":"Build With AI Builder","text_ltd_connect_website_popup_desc":"Install the 10Web Manager plugin to be able to recreate<br/>websites with AI assistance of the 10Web builder.","text_ltd_connect_website_popup_step1":"Download 10Web Manager Plugin","text_ltd_connect_website_popup_step2":"Install and activate the plugin from the WP admin","text_learn_more":"Learn more","text_buyHosting":"Buy hosting","text_earlyBirdSpecial":"Special Offer","text_earlyBirdLtdUpgradePlanHeader":"20% Discount Until October 16, 2020","text_earlyBirdLtdUpgradePlanStarterDesc":"Upgrade now and get 20% off on Lifetime Deal","text_earlyBirdLtdUpgradePlanStarterDescNew":"Upgrade now and get the deal with 20% off as the prices will go up on October 16","text_earlyBirdLtdUpgradePlanLtdDesc":"Boost the number of your websites by upgrading to a higher plan.","text_ltdUpgradePlanHeader":"Grab Our Exclusive Lifetime Deal. Limited Time Offer.","text_aiUpgradePlanHeader":"Your Demo Website Has Expired","text_aiUpgradePlanDesc":"Upgrade to enjoy all the benefits of 10Web AI Builder","text_aiUpgradePlanExpiredDesc":"Buy now & enjoy all the benefits of 10Web AI Builder\\n\\n","text_ltdUpgradePlanStarterDesc":"Pay once, use forever.<br/>Take advantage of this great deal now! Prices are subject to increase.","text_ltdUpgradePlanStarterDescOfferEnd":"Pay once, use forever.<br/>Take advantage of this great deal now, before it ends on <span>December 3rd</span>.","text_ltdUpgradePlanLtdDesc":"Boost the number of your websites by upgrading to a higher plan.","text_currentPlan":"Current Plan","text_faq":"FAQ","text_createNewWebsite":"Create a website","text_useAiTemplatesThemes":"Use AI, templates or themes","text_migrateYourWebsite":"Migrate your website","text_optimizeYourWebsite":"Optimize your website","text_exclusiveDeal":"Exclusive Deal \u{1f525}","text_exclusiveDealDescription":"Special discount on 20+ websites","text_hostAndOptimize":"Host & optimize on 10Web","text_dontReloadPage":"Please don\u2019t reload this page","text_fasterFrontend":"Faster frontend on any hosting","text_appsumoDealDesc":"Activate AI assistance for your<br/>Appsumo {{number}}","text_appsumoVideoTitle":"Get Started With 10Web Website<br/>Builder With AI Assistance","text_appsumoVideoDesc":"AI Builder free trial for AppSumo users","text_appsumoVideoSubDesc":"Purchase your plan and test the AI Builder.","text_appsumoFeatureSectionTitle":"Built for Professionals<br/>From Tech-Savvy Individual to Agency","text_appsumoHowToSectionTitle":"How AI Website Builder Works","text_LTDAdditionalSubscriptionBlockTitle":"Automated WordPress Hosting","text_planPrice":"Price","text_tenwebxHeaderSubTitle":"Premium Automated WordPress Hosting","text_tenwebxMessage":"\u201cIf you\u2019re a freelancer or agency, 10Web hosting will be the best <br> choice for you. <br><br> At 10Web, we offer a automated WordPress hosting on Google Cloud,<br> and we are simply obsessed with providing a high PageSpeed for <br> WordPress to all our users. We guarantee that every website hosted <br> on our platform or migrated from elsewhere, gets an automatic 90+ <br> PageSpeed score.","text_tenwebxMessageMoney":"You can purchase a website for $72/yr billed annually, test it <br> out, and if you are not satisfied with the hosting.\u201d","text_tenwebxDealTitle":"10Web Hosting","text_tenwebxBilledAnnually":"Billed Annually","text_tenwebxDealHostedSite":"<b> 1 </b> <span> Hosted Site </span>","text_tenwebxDealMonthlyVisitors":"<b> 25K </b> <span class=\'db-ai-builder-feature-point\'> Monthly Visitors </span>","text_tenwebxDealSSDStorage":"<b>5GB</b> <span class=\'db-ai-builder-feature-point\'> SSD Storage </span>","text_tenwebxPointsTitle":"What Makes 10Web The Best Fully Managed Wordpress Host?","text_tenwebxPointScoreTitle":"90+ PageSpeed Score","text_tenwebxPointScoreDesc":"Fully automated optimization solution including smart <br> hosting configuration, image optimization & lazyload, <br> JS & CSS minification, and much more that guarantees <br> your website\u2019s 90+ PageSpeed score.","text_tenwebxPointScoreTitleTooltip":"In certain cases a 95+ PageSpeed score is not possible because of external <br> scripts, large images, large JS & CSS files, and a large quantity of plugins. If your <br> PageSpeed score is lower than 90, please contact our Customer care team.","text_tenwebxFeatureSectionTitle":"10Web provides services that are tailored specifically for WordPress","text_tenwebxDialogHostingTitle":"AI Website Builder Works <br> Best on 10Web Hosting","text_tenwebxDialogHostingDesc":"Enjoy the full benefits and features of AI Website Builder<br> with 10Web Automated WordPress Hosting on Google Cloud","text_tenwebxMigrateTitle":"Fully Automated <br> Website Migration","text_tenwebxMigrateDesc":"Simply install our migration plugin, make a copy of <br> your live website, and test your site on 10Web hosting.","text_tenwebxTestimonialsTitle":"Here\u2019s What Our Clients Have to Say About <br> Their Experience With 10Web","text_tenwebxVisitorstooltip":"For every 10K extra visitors you\'ll be charged an extra $2<br> at the end of the billing month","text_tenwebxPointsTooltip":"In certain cases a 90+ PageSpeed score is not possible because of <br> external scripts, large images, large JS & CSS files, and a large quantity of plugins.<br> If your PageSpeed score is lower than 90, please contact our <a target=\'_blank\' href=\'https://10web.io/contact-us/\'><span> Customer care </span></a> team.","text_pwdValidationtitle":"Your password must have:","text_pwdCharacters":"8 or more characters","text_pwdUpperLowerCase":"Upper and lowercase letters","text_pwdNumber":"At least one number","text_pwdValidationSubTitle":"Strength:","text_pwdValidationDesc":"After going through all these points, <br> your password will be stronger and <br> hard to guess.","text_invalidPassword1":"Please enter a secure password.","text_requiredPassword1":"Password is required","text_pluginsEmptyTitle":"We did not find results<br/>matching your search criteria.","text_chatMessenger":"Messenger","text_referFriend":"Refer a friend","text_connectDomain":"Connect a custom domain","text_chatSlack":"Join Slack community","text_chatOpenTopic":"Open Topic","text_chatSales":"Sales","text_chatWhatsApp":"WhatsApp","text_knowledgeBase":"Knowledge base","text_knowledgeBaseEmpty":"No results found","text_whatsNew":"What\u2019s new","text_tenWebCare":"10Web Care","text_openArticle":"Open this article on new tab","text_filteredArticles":"{{articlesCount}} results","text_availableWebsites":"{{availableWebsites}} Free Website {{slots}} Available","text_availableWebsitesDesc":"Migrate your website or build one using any theme & plugin, 10Web builder and AI assistance.","text_add-website-desc1":"With 10Web, you can automatically create an optimized copy of <br> your website with a 90+ PageSpeed score without impacting your original website.","text_add-website-desc2":"All you need to do is download and install the 10Web Manager plugin. After that <br> an optimized copy of your website will be created automatically in 10-30 minutes.","text_add-website-desc3":"Test your optimized website copy, compare the score, and play with the hosting features.","text_add-website-tooltip":"In certain cases a 90+ PageSpeed score is not possible because of external scripts, large images, large JS & CSS files, and a large quantity of plugins. If your PageSpeed score is lower than 90, please contact our  <a target=\'_blank\' href=\'https://10web.io/contact-us/\'> Customer care </a> team.","text_chatLiveChat":"Live chat","text_chatContactSales":"Contact sales","text_mainPaymentMethod":"Main payment method","text_mobileDisclaimerWelcomeTitleTrial":"Welcome To 10Web","text_mobileDisclaimerWelcomeTitleAi":"Welcome To AI Builder","text_mobileDisclaimerMainTitle":"10Web Dashboard Available <br class=\'db-new-line-for-mobile\' />Only on Desktop.<br/>Check your Email to Login <br class=\'db-new-line-for-mobile\' />with Magic Link.","text_mobileDisclaimerDescAi":"To experience the full capability of <br class=\'db-new-line-for-mobile\' />Automated Website Creation Based <br class=\'db-new-line-for-mobile\' />on AI<br class=\'db-new-line-for-desktop\' /> login on desktop with 1 click <br class=\'db-new-line-for-mobile\' />from the email we\u2019ve sent you.","text_mobileDisclaimerDescTrial":"To experience the full capability of <br class=\'db-new-line-for-mobile\' />Automated WordPress Platform login<br />on desktop with 1 click from the email <br class=\'db-new-line-for-mobile\' />we\u2019ve sent you.","text_mobileDisclaimerDescOptimizer":"To explore Automated 90+<br class=\'db-new-line-for-mobile\' /> PageSpeed Optimization by 10Web <br class=\'db-new-line-for-mobile\' /> login<br class=\'db-new-line-for-desktop\' /> on desktop with 1 click from the<br class=\'db-new-line-for-mobile\' /> email we\u2019ve sent you.","text_subscriptionRenewTitle":"Subscription renewal","text_subscriptionRenewDesc":"Please renew your subscription to be able to continue using 10Web Automated Hosting Platform.","text_subscriptionRenewDescBundle":"Please renew your subscription to be able to continue using 10Web.","text_subscriptionRenewDescBoosterProAiPro":"Please renew your subscription to be able to continue<br/>using 10Web Booster.","text_subscriptionRenewDescBoosterFreeOrAiFree":"Please renew your subscription to continue using<br/>10Web services.","text_defaultForAdditional":"Default payment method For Additional Fees","text_upgradePlanStarterNoUpFrontPayment":"No Up-front Payment","text_upgradePlanStarterCancelAnytime":"Cancel Anytime","text_expiredPlanStarterSubHeader":"Get 7 Days of 10Web Pro Plans for Free","text_newAiBuilderFlowHeader":"Get all of the 10Web pro features","text_expiredPlanStarterHeader":"Your trial has expired, but you can still explore 10Web for free for another month.","text_freeOfferDesc":"Explore all 10Web premium features, create, migrate & optimize up to 10 websites.","text_freeOfferDescForDemo":"Edit your website, host it on a Google Cloud Partner hosting and get a 90+ PageSpeed score","text_freeOfferDescForDemoWithDomain":"Edit, launch and host your superfast website on 10Web with <span class=\'doted\'>a free domain for up to $30.</span>","text_freeOfferDescPercent":"Access all of 10Web\u2019s optimization, hosting, and website building benefits with a 30% lifetime discount.","text_geoFirstYearDesc":"Special prices for the first year for new customers","text_trialCouponDesc":"Special offer with the {{coupon}} promo code","text_boosterProSubheader":"Optimize more websites with 10Web Booster","text_platformOfferDesc":"Migrate, optimize or create more websites with a 90+ PageSpeed score","text_alreadyHaveAccountTitle":"Existing Account","text_alreadyHaveAccountMessage":"You already have an account with this email.<br/>We\u2019ve signed you in.","text_performance.pageSpeedJoined90+":"<b>Automated Optimization</b> 90+ PageSpeed Score","text_performance.pageSpeedOptimizeWebsite90+":"<b>Automated Optimization</b> 90+ PageSpeed Score","text_performance.pageSpeedCopyWebsite90+":"<b>Copy your website</b><br/>90+ PageSpeed score","text_copyWebsiteTitle":"Test Any Other Website\u2019s Speed <br> on 10Web Hosting","text_copyWebsiteDesc":"Create a copy of your website with automated migration to get a 90+ PageSpeed score.","text_copyWebsiteTooltip":"<b>Test Any Other Website\u2019s Speed <br> on 10Web Hosting</b><br><span>Create a copy of your website with automated migration to get a 90+ PageSpeed score.</span>","text_domainsExceededTitleDialogAppsumoLTD":"You\u2019ve reached the limit of recreated websites.<br/>To recreate more websites, please {{action}}.","text_demoLabelTooltip":"This is a test website","text_starter_connect_website_popup_title":"Install 10Web Manager Plugin to <br> copy your website to 10Web without <br> impacting your original website","text_starter_connect_website_popup_title_new":"Install our Manager Plugin<br> to Copy Your Existing Website<br> to 10Web Hosting","text_starter_connect_website_popup_desc":"Your website copy will replace your trial website on 10Web hosting.","text_regionDescriptionSignUp":"Choose the Data Center/Location for your website","text_installWebsiteDialogSuccessTrial":"Let automation take over your manual work, saving you time to grow your business.","text_sslFailed.title":"Free SSL generation failed","text_sslFailed.desc":"If you are using Cloudflare please follow these instruction","text_enableHttps.title":"Generate free certificate","text_enableHttps.desc":"We provide free SSL certificates, granting you a secure https connection. <br/> To generate a certificate, at least one live domain should be pointed to your 10Web servers.","text_installWebsiteDialogSuccessTrialTitle":"Your Website on 10Web is Created","text_enableHttps.subTitle":"Select the domain(s) for which you want to generate SSL certificate.","text_migrationFlowLowScore":"<b>In some cases an automatic 90+ is not possible.</b><br> Request manual optimization. We will try to reach a 90+ Page Speed score manually.","text_migrationFlowLowScoreInProgress":"<b>Optimization in progress</b><br> Our team is working to optimize your website to reach the highest possible PageSpeed score.","text_migrationFlowLowScoreOptimize":"Optimize My Website","text_migrationFlowLowScoreManualOptimize":"Manual Optimization<br/> Request Submitted","text_migrationFlowLowScoreManualOptimizeDesc":"Please check your inbox. A member of our team will contact you once the optimization has completed.","text_copyWebsitePageTitle":"Your Trial Website PageSpeed Score","text_copyWebsitePageGet90":"Want to Get 90+ PageSpeed Score <br> For Any Other Website?","text_signUpTitle":"Build and host websites<br class=\'db-mobile\' />with 10Web AI Builder","text_signUpTitleBooster":"Access the Benefits<br/> of 10Web Booster","text_signUpTitleAiAssistant":"Access the benefits<br/> of 10Web AI Assistant","text_signUpTitleStartAi":"Your website<br/> is waiting for you!","text_signUpDescStartAi":"Create your account now to access<br/>your newly generated site.","text_signUpTitleImageOptimizer":"Access the benefits of<br/> Image Optimizer","text_signUpListing0":"Build and host a website 10X faster with AI","text_signUpListing1":"Get AI generated content and images","text_signUpListing2":"Customize with Elementor based editor","text_signUpListing3":"Get a 90+ PageSpeed score with Booster","text_signUpListingAi0":"Fix SEO & readability errors","text_signUpListingAi1":"Work directly in Gutenberg & Classic Editor","text_signUpListingAi2":"20+ use case templates","text_signUpListingAiStart0":"Preview your AI Powered website","text_signUpListingAiStart1":"Customize with Elementor based editor","text_signUpListingAiStart2":"Add more pages and complete your website","text_signUpListingAiStart3":"Get a 90+ PageSpeed score with Booster","text_signUpListingAi3":"24/7 customer care","text_signUpBoosterListing0":"90+ PageSpeed score","text_signUpBoosterListing1":"Image optimization","text_signUpBoosterListing2":"Improved Core Web Vitals","text_signUpBoosterListing3":"Full caching","text_upgradePlanHostedSite":"For more websites, <br/>please upgrade to a higher plan","text_aiWebsiteBuilder":"Get a fully functional copy of your website on WordPress using our AI Website Builder","text_copyWebsitePageInstallPlugin":"Install our Manager Plugin to Copy Your<br/>Existing Website to 10Web Hosting","text_migrationFlowHighlightDesc":"Create an optimized copy of your website on<br/>10Web with 1 click and enjoy a 90+ PageSpeed<br/>score.","text_optimizerPluginInstall":"<b>10Web Optimizer plugin is not installed.</b><br/>The 10Web Optimizer Plugin is mandatory for getting a PageSpeed score of 90+","text_optimizationProgress":"<h3>Website Optimization in Progress</h3><p>Your website is being optimized. Depending on its size, </br>this process may take a while.</p>","text_loginWithGoogle":"Login with Google","text_continueWithGoogle":"Continue with Google","text_hostedDomainsExceededTitle":"<span>You exceeded the limit<br/> of websites</span>","text_hostedDomainsExceededDesc":"Upgrade to a higher plan to create, migrate or optimize<br/> more websites.","text_hostedDomainsExceededBuyMoreDesc":"Buy additional sites to create, migrate or optimize<br/> more websites.","text_hostedDomainsExceededMigrateDesc":"To migrate more websites<br> you need to upgrade to a paid plan.","text_hostedDomainsExceededTitleExpired":"<span>Your trial hosting has expired</span>","text_hostedDomainsExceededDescExpired":"Please upgrade to be able to host websites at 10Web.","text_hostedDomainsExceededTest":"If you want to test another website during the trial you can remove <br> your current website hosted on 10Web.","text_hostedDomainsExceededMigrateTest":"If you want to migrate another website during the trial,<br> you can remove your current website hosted on 10Web.","text_yourWebsiteCopyHosted":"Your Website Copy Hosted at 10Web","text_yourCurrentWebsite":"Your Current Website","text_talkToSpecialist":"Talk to a Specialist","text_createCopyWebsite":"Create a Copy of Your Website","text_websiteMigration":"Website Migration","text_fillFieldsToCopy":"To copy your website to 10Web Managed Hosting, please fill out the fields below. We will automatically create a copy of your website on 10Web Managed Hosting.","text_fillAllNecessaryInfo":"Fill all necessary info to start Fill out all the new info necessary for the migration process. We bet migrating birds have to fill out something similar, too.","text_checkManualMigrateType":"Please check manual migrate type","text_noWorries":"No worries, give us your site info and we\u2019ll migrate manually within 24 hours.","text_autoMigrating":"We\u2019ve encountered an issue while automatically migrating your site. <br>Our team will manually migrate your site within 24 hours.","text_automaticCopy":"The Automatic Copy of your website can not be completed","text_manuallyCopyWebsite":"We will manually copy your website for free in 24 hours","text_feelOutTheForm":"Please feel out the form below to proceed","text_dbMatters":"Database matters","text_requiredDb":"We may also need phpMyAdmin credentials to access your database.","text_requiredUrl":"This field is required. Please enter your URL.","text_requiredUsername":"This field is required. Please enter your Username.","text_requiredPassword":"This field is required. Please enter your Password.","text_requiredPort":"This field is required. Please enter your Port.","text_requiredServerAddress":"This field is required. Please enter your Server Address.","text_ftpInfo":"FTP/SFTP/SSH cases need just a tad more info.","text_checkInfo":"Please check that all the information you provided is correct","text_accessForManualMigrate":"We need this access to be able to manually migrate your website.","text_grantAccess":"I agree to grant 10Web temporary access to my dashboard and websites.","text_hostingPanelCredentials":"Please Provide Your Hosting Panel Credentials","text_automaticCopyCantCompleted":"Request Premium Migration for Free","text_automaticFeelOutForm":"Something on your website is blocking the automated migration. Please submit the form<br/> below to get a premium manual migration for free within 24 working hours.","text_requestManualMigration":"Request manual migration","text_homePageUrl":"Homepage URL","text_websiteDetails":"Website details","text_hostingDetails":"Hosting details","text_hostingPanelLoginUrl":"Hosting panel login URL","text_hostingPanelUsername":"Hosting panel username","text_hostingPanelPassword":"Hosting panel password","text_additionalInstruction":"Additional Instruction","text_migrateExistingSite":"To migrate your existing site to 10Web Automated hosting, fill in your website credentials.","text_retry":"Retry","text_renew":"Renew","text_upgradeNowEndContinue":"Upgrade now and continue enjoying super fast automated hosting & more! Your trial expires","text_upgradeNowAndEnjoy":"Upgrade now to enjoy your super fast website on 10Web managed hosting.","text_addAdditionalWebsite":"Add additional website","text_automatedWpHosting":"Automated WordPress Hosting","text_showDefaultPaymentMethod":"Default payment method","text_addMoreWebsitesPersonal":"To add more websites than included in your current plan,<br/> upgrade to one of our higher plans.","text_addMoreWebsitesPremium":"To add more websites and unlock exclusive agency features,<br/> upgrade to our Agency plan. ","text_optimizeMoreWebsitesPersonal":"To optimize more websites than included in your current plan, upgrade to one of our higher plans.","text_optimizeMoreWebsitesPremium":"To optimize more websites and unlock exclusive agency features, upgrade to our Agency plan.","text_optimizeMoreWebsitesAgency":"Buy an additional website to be able to add another website<br/> to your current plan.","text_purchaseAdditionalWebsite":"Buy an additional website to be able to add another website<br/> to your current plan.","text_purchaseAdditionalWebsiteOneLine":"Buy an additional website to add another website to your current plan.","text_getTrialPeriod":"Get {{trialPeriod}} months of free <span>10Web Automated WordPress Hosting</span> on Google Cloud.","text_upgradeANdEnjoyOptimizing":"Upgrade now and enjoy your optimized website for <br/>{{trialPeriod}} month free. Your trial hosting expires&nbsp;","text_rechargePaymentFailedTitle":"Payment Failed","text_rechargePaymentFailedUnavailableGeneral":"<span>Payment Failed:</span> Complete your payment to avoid interruptions<br class=\'show-desktop\'/> and keep your website available.","text_rechargePaymentFailedUnavailable1":"Complete your payment to avoid interruptions and keep your website available.","text_rechargePaymentFailedUnavailable2":"Please make a payment to get plugin updates and premium customer support.","text_rechargePaymentFailedNotEnterprise":"If payment is not made, your website will become unavailable. Please retry.","text_rechargePaymentFailedEnterprise":"If payment is not made, you will not receive premium customer support and plugin updates. Please retry.","text_rechargePaymentFailedHeader":"Please make a payment to get plugin updates and premium customer support.","text_rechargePaymentFailedDesc1":"Please check that your payment information is up to date or use a different payment method,<br/> then retry. If payment is not made, your website will become unavailable.","text_rechargePaymentFailedDesc2":"Please check that your payment information is up to date or use a different payment method,<br/> then retry. If payment is not made, you will no longer receive premium<br/> customer support and plugin updates.","text_buildingWebsiteFor":"I am Building This Website For\u2026","text_describeQuestion1Title":"Welcome to 10Web","text_describeQuestion1Desc":"What role describes you the best?","text_describeQuestion2Desc":"What is the industry of your agency?","text_describeQuestion3Desc":"How many websites do you manage?","text_describeQuestion4Desc":"What is the main reason you are joining 10Web?","text_myself":"Myself","text_myClient":"My Client","text_digitalAgency":"Digital Agency","text_freelanceDeveloper":"Freelance Developer","text_smb":"Small or Medium-Sized Business","text_entrepreneur":"Entrepreneur","text_question2Option1":"Web development agency","text_question2Option2":"Marketing agency","text_question2Option3":"Design agency","text_question2Option4":"Other","text_question3Option1":"Under 10","text_question3Option2":"Under 50","text_question3Option3":"Under 100","text_question3Option4":"100+","text_question4Option1":"To get 90+ PageSpeed score","text_question4Option2":"To get a secure and reliable hosting","text_question4Option3":"To reduce hosting costs","text_question4Option4":"Other","text_starterFeature":"Unlock all of 10Web. Create or migrate 10 websites and explore our premium features for {{couponDays}}.","text_boosterFeature":"Optimize the frontend of your entire website.<br/> Get additional 60% performance boost and unmatched<br/> security with Cloudflare Enterprise integration. ","text_introducingWorkspace":"Introducing Workspace & User Management","text_introducingWorkspaceDesc":"To facilitate website management, we have created Workspace, where you can:<br><br> 1. Invite co-workers or employees to your workspace. Collaborate, manage, and give them different roles and permissions.<br><br> 2. Accept invitations to join other workspaces and easily switch between them.","text_welcomeOwnActivityLog":"Introducing the new Activity Log!","text_welcomeOwnActivityLogDesc":"A whole new experience for monitoring the activities on 10Web. In this section, you can see all the actions that you & your teammates did on the 10Web dashboard.","text_welcomeOwnWorkspaceSwitch":"Switch Between Workspaces","text_welcomeOwnWorkspaceSwitchDesc":"Click on the workspace access drop down to change workspace.","text_welcomeOwnWorkspace":"Welcome to Your Own Workspace","text_welcomeOwnWorkspaceDesc":"1. Invite co-workers or employees to your workspace. Collaborate, manage, and give them different roles and permissions.<br><br> 2. Accept invitations to join other workspaces and easily switch between them.","text_inviteUsersSMBPaid":"Invite your team","text_inviteUsersSMBPaidDesc":"Bring in a developer to 10Web dashboard to build and manage your website.","text_inviteUsersSMBPaidButton":"INVITE YOUR DEVELOPER","text_inviteUsersSMBTrial":"Collaborate with your team","text_inviteUsersSMBTrialDesc":"Bring in your team members to 10Web dashboard to build and manage your website together.","text_inviteUsersSMBTrialButton":"INVITE YOUR TEAM","text_inviteUsersAgencyPaidButton1":"INVITE TEAM MEMBER","text_inviteUsersAgencyPaidButton2":"INVITE A CLIENT","text_inviteUsersAgencyTrialButton":"SEND AN INVITATION","text_inviteUsersAgency":"Invite your team & client to 10Web","text_inviteUsersAgencyDesc":"Bring in your developers and your clients to 10Web dashboard to improve collaboration in building and managing websites.","text_inviteUsersFreelancer":"Invite Your Client to 10Web","text_inviteUsersFreelancerDesc":"Bring in your clients to 10Web dashboard to improve collaboration in building and managing websites.","text_inviteUsersFreelancerButton":"INVITE YOUR CLIENT","text_inviteUsers":"Invite Users","text_emailAddresses":"Email Address(es)","text_usersLimit":"You can add up to 10 email addresses separated by commas.","text_workspaceAdmin":"Admin","text_workspaceAdminDescription":"Access to all workspace features & billing except user management.","text_workspaceDev":"Contributor","text_workspaceContributorDescription":"Access to adding, removing & managing all websites in the workspace. No access to user management, white label & billing. Perfect for lead developers & project managers.","text_workspaceMemberDescription":"Access only to selected websites\u2019 live or staging environments. Perfect for clients, developers, designers or marketers.","text_workspaceDevDescription":"Full access to websites only.<br> No access to user management, billing, white label, & workspace settings.","text_workspaceAccessDescription":"Full access to everything except user management or full access to websites only.<br> No access to billing & workspace settings.","text_siteAccessDescription":"Partial or full access to select websites. (Live/Staging environments)","text_siteFullAccessDescription":"Full access to select websites.<br>(Live/Staging environments)","text_siteStagingAccessDescription":"Access to staging environment only","text_improveYourWebsiteManagementFlow":"Improve Your Website <br>Management Workflow","text_improveTheWebsiteManagementFlow":"Improve The Website <br>Management Workflow","text_inviteTeamAndClientsCollaborate":"Invite your team and clients into a unified workspace to collaborate on websites together.","text_inviteMembersCollaborate":"Invite your team members into a unified workspace to collaborate on your website together.","text_inviteTeamOrMembersCollaborate":"Invite your team members or clients into a unified workspace to collaborate on the website together.","text_workspace":"{{workspaceName}}\u2019s Workspace","text_switchWorkspace":"Workspace & settings","text_workspaceUpdate":"Workspace is currently on 10Web\'s {{type}}.","text_workspaceUpdatePro":"{{type}}","text_workspaceUpdateProCurrentPlan":"Current plan: {{type}}","text_workspaceUpdateBooster":"Get 10Web Booster Pro","text_workspaceUpdateAiAssistant":"Get 10Web Pro","text_workspaceSettings":"Workspaces Settings","text_loadingTitle":"A Blank WordPress Website <br> is Being Installed on 10Web Hosting","text_loadingDesc":"Please wait and don\u2019t reload the page","text_loadingStep1":"Setting up the Hosting","text_loadingStep2":"Installing WordPress","text_loadingStep3":"Finalizing","text_automated-hosting":"Automated hosting on Google Cloud","text_automated-hosting-booster":"<span class=\'with-logo\'>Automated hosting add-on</span> <img src=\'../../../../../assets/images/logos/powered-by-google.png\'/>","text_price-per-website":"Price per website","text_price-per-website-tooltip-body":"Get website security, performance and reliability boost thanks to the Cloudflare Enterprise.","text_price-per-website-booster-tooltip-body":"Migrate your website to 10Web\'s automated hosting on Google Cloud to get a 99.9% uptime, optimize your backend performance and get a multitude of website management tools.","text_wordpress-installs":"WordPress installs","text_wordpress-installs-tooltip-body":"Every install also includes a free staging environment for testing plugins, themes, and updates.","text_monthly-visits":"Visits","text_monthly-visits-tooltip-body":"For every 10K extra visitors you\u2019ll be charged an extra $2 at the end of the billing month.\\nVisits are measured by the total monthly traffic (unique IPs) to your site. These visits are distributed across all websites within your plan.","text_ssd-storage":"Storage","text_ssd-storage-tooltip-body":"All servers use the fastest SSD storage on Google Cloud with built-in redundancy to ensure data integrity.","text_real-time-backup-header":"Real-time backup","text_real-time-backup-tooltip-body":"Schedule automatic backups and restore a previous version of your site whenever needed.","text_99plus-uptime":"99.9% uptime","text_99plus-uptime-tooltip-body":"Websites hosted on 10Web are up and running 99.9% of the time without a glitch due to Google Cloud.","text_google-cloud":"Google cloud platform","text_google-cloud-tooltip-body":"Powered by Google Cloud, 10Web hosting is extremely fast and secure.","text_white-label":"White Label","text_white-label-tooltip-body":"White label your WordPress dashboard of websites hosted at 10Web and take your business to the next level.","text_multisite-support":"Multisite support","text_multisite-support-tooltip-body":"Install WordPress multisite and manage all aspects of your WordPress multisite from the 10Web dashboard.","text_client-management":"User & team management","text_client-management-tooltip-title":"User & Team Management","text_client-management-tooltip-body":"Create users and give them different permissions to your account and websites.","text_additional-sites":"Additional hosted sites","text_additional-websites":"Additional websites","text_additional-websites-tooltip-body":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>${{price}}/mo</b> Per Site","text_additional-websites-tooltip-body6":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>$6/mo</b> per site","text_additional-websites-tooltip-body8":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>$8/mo</b> per site","text_additional-sites__enterprise-tooltip":"You can buy additional hosted<br/> websites after the upgrade<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>${{price}}/mo</b> per site<br/><b>+ 20K</b> visits</br><b>+ 5GB</b> SSD storage","text_additional-sites-tooltip-body":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>${{price}}/mo</b> Per Site<br/><b>+ 20K</b> Visits</br><b>+ 5GB</b> SSD Storage","text_additional-sites-tooltip-body6":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>$6/mo</b> Per Site<br/><b>+ 20K</b> Visits</br><b>+ 5GB</b> SSD Storage","text_additional-sites-tooltip-body8":"Get more websites<br/><i class=\\"db-icon db-icon-ds-checkmark\\"></i> <b>$8/mo</b> Per Site<br/><b>+ 20K</b> Visits</br><b>+ 5GB</b> SSD Storage","text_whiteLabel-tooltip-body":"White label your WordPress dashboard of websites hosted at 10Web and take your business to the next level.","text_whiteLabelBooster-tooltip-body":"White label 10Web dashboard or 10Web Booster and take your business to the next level.","text_datacenter-locations":"12 datacenter locations","text_datacenter-locations-tooltip-body":"Choose between 12 global data center locations for each WordPress install. Your datacenter should be close to your visitors.","text_staging-area":"Staging area","text_staging-area-tooltip-body":"Stage and test the coming updates on your website\u2019s clone before publishing them.","text_automatic-backups":"Automatic daily backups","text_automatic-backups-tooltip-body":"Automatic daily system level backups are conducted for all sites. You can restore a website with a single-click.","text_php-support":"PHP 8.0 support","text_php-support-tooltip-body":"Use the latest and safest version of PHP on 10Web hosting.","text_premium-dns":"Premium DNS","text_premium-dns-tooltip-body":"Link the IPs to domains with a fast and secure Domain Name Service.","text_free-ssl":"Free SSL and SSH","text_free-ssl-tooltip-body":"10Web provides you with a free one-click SSL using Let\u2019s Encrypt integration and SSH access to automate your workflow.","text_imported-ssl":"Imported SSL certificates","text_imported-ssl-tooltip-body":"You can also install your own SSL certificate.","text_plugin-management":"Third-Party Plugin Management","text_plugin-management-tooltip-body":"Effortlessly manage plugins by all possible sources from the same unified dashboard.","text_wp-core-updates":"WordPress Core Updates","text_wp-core-updates-tooltip-body":"Easily update WordPress core through our intuitive dashboard.","text_db-optimization":"Automatic Database Optimization","text_db-optimization-tooltip-body":"Once a week, the 10Web platform automatically taylors MySQL database settings according to the needs of your website.","text_malware-program":"Malware Removal Program","text_malware-program-tooltip-body":"Infected and hacked sites are restored and cleaned for free while hosted at 10Web.","text_self-healing":"Self-Healing Technology","text_self-healing-tooltip-body":"Automatic restart of PHP if it has gone down.","text_1-click-migration":"<b>Automated Migration</b>","text_1-click-migration-tooltip-body":"Move your website to 10Web from any other hosting with just 1 click.","text_caching":"Caching","text_caching-tooltip-body":"Cache your website with Nginx FastCGI for faster load.","text_IO-service":"Image Optimization Service","text_IO-service-tooltip-body":"Compress your high resolution images for up to 90% without major quality loss.","text_website-builder":"AI Builder","text_ai-builder-regeneration":"Amount of website generations with AI","text_ai-builder-regeneration-tooltip-body":"Answer our brief questionnaire, and our AI-powered content generator will create tailored content and images for your business.","text_ai-builder-recreation-assistant":"AI recreation","text_ai-builder-recreation-assistant-tooltip-body":"Insert the URL of any web page you like to recreate the layout. It will inherit the design elements and header & footer of your homepage.","text_ai-builder-responsive-design":"Responsive design","text_ai-builder-responsive-design-tooltip-body":"Adapt any website you build to mobile, tablet or any other device with ease.","text_cloudflare-enterprise":"Cloudflare Enterprise","text_cloudflare-enterprise-booster":"Cloudflare Enterprise CDN","text_pro_optimization-booster":"Pro optimization","text_cloudflare-enterprise-hosted":"Cloudflare Enterprise CDN add-on","text_cloudflare-enterprise-tooltip-body":"Get website security, performance and reliability boost thanks to the Cloudflare Enterprise included in all paid plans of 10Web.","text_cdn-website":"Websites with CDN","text_cdn-website-tooltip-body":"You can get additional website CDN and 100GB Bandwidth for $4/mo.","text_cdn-website-tooltip-body4":"You can get additional website CDN and 100GB Bandwidth for $4/mo.","text_cdn-website-tooltip-body5":"You can get additional website CDN and 100GB Bandwidth for $5/mo.","text_cdn-bandwidth":"CDN bandwidth","text_cdn-bandwidth-tooltip-body":"For every 50GB of extra bandwidth you\u2019ll be charged an extra $5 at the end of the billing month. 100GB of bandwidth is on average equivalent to 50K website visits.","text_ddos-protection":"DDoS attack protection","text_ddos-protection-tooltip-body":"Protect your website with Cloudflare\u2019s enterprise-grade unmetered mitigation of DDoS attacks.","text_faster-load-times":"Up to 10X faster load times","text_faster-load-times-booster":"2x faster load times","text_faster-load-times-gallery_desc":"Improve the website performance thanks to 10Web Booster Pro & Cloudflare Enterprise integration.","text_faster-load-times-booster-tooltip-body":"Improve the website performance thanks to Cloudflare Enterprise integration.","text_faster-higher-score-booster":"50% higher PageSpeed score","text_faster-higher-score-booster-tooltip-body":"Get an additional boost to your website PageSpeed score","text_faster-cache-locations":"275 caching locations worldwide","text_faster-load-times-tooltip-body":"275 data centers located across the globe provide visitors with location-based access to your website, while removing latency and improving performance.","text_ttfb":"Under 100ms TTFB","text_ttfb-tooltip-body":"Reduce the time it takes for your user\'s browser to receive the first batch of your data to under 100ms.","text_full-page-cache-network":"Full page caching on edge network","text_full-page-cache-network-tooltip-body":"Improve server response time and loading by enabling full page caching for static pages to read entirely from the cache.","text_waf":"Web Application Firewall (WAF)","text_waf-tooltip-body":"Cloudflare\u2019s Web Application Firewall protects your website from DDoS and Bot attacks, Brute force attacks, and other threats.","text_templates":"Theme builder","text_templates-tooltip-body":"Turn any web page into a template with our AI Builder, all without copying a single line of code.","text_drag&drop-editor":"Drag & drop live editor based <br>on Elementor","text_drag&drop-editor-booster":"Drag & drop live editor based on Elementor","text_drag&drop-editor-tooltip-body":"Edit newly built websites using the 10Web Editor based on Elementor. Drag and drop widgets and customize them to your own unique style.","text_premium-widgets":"50+ basic & pro widgets","text_premium-widgets-tooltip-body":"We have enhanced Elementor with our 50+ premium widgets.","text_automated-migration":"Automated 1-click migration","text_automated-migration-tooltip-body":"Move your website to 10Web from any other hosting with just 1 click.","text_malware-removal-program":"Malware removal program","text_malware-removal-program-tooltip-body":"Scheduled automatic scanning for security issues in your current versions of WordPress core, themes, plugins and unwanted changes made to your files.","text_freeSsl":"Free SSL certificate","text_Ssh-access":"SSH access","text_Ssh-access-tooltip-body":"SSH access automates your workflow and eliminates risks of man-in-the-middle attacks, keeping data transmissions private.","text_freeSsl-tooltip-body":"10Web provides you with a free one-click SSL using Let\u2019s Encrypt integration. The SSL certificate will automatically renew once expired, without additional interference.","text_wpPluginsUpdate":"WordPress and plugins update","text_wpPluginsUpdate-tooltip-body":"Easily update WordPress core through our intuitive dashboard","text_user-team-management":"User & Team Management","text_user-team-management-tooltip-body":"Collaborate with your team members and clients from one workspace. Invite your team to your workspace, give them granular access to work on different aspects of the site.","text_automated-real-time-backup":"Real-time Backup","text_cloud-storage":"Cloud storage","text_cloud-storage-tooltip-body":"Backup files are safely stored in AWS S3 Cloud.","text_sync-technology":"Sync technology","text_sync-technology-tooltip-body":"To save your time and space, only the changes that occurred after the last full backup are saved.","text_one-click-backup":"One-Click Backup of The Whole Site","text_one-click-backup-tooltip-body":"Just click once and your website backup is ready.","text_one-click-restore":"One-click restore","text_one-click-restore-tooltip-body":"Restore your website to a previous version with just a click.","text_backup-download":"Backup download","text_backup-download-tooltip-body":"Download your backups for extra security.","text_real-time":"Real Time Scheduling","text_real-time-tooltip-body":"Schedule your active website to automatically backup every single hour.","text_customized-backup":"Customized backup","text_customized-backup-tooltip-body":"No intentions for a full backup? Customize your backup by manually selecting the files you want to backup.","text_security-scanner":"<b>Security Scanner</b>","text_security-scanner-tooltip-body":"Scheduled automatic scanning for security issues in your current versions of WordPress core, themes, plugins and unwanted changes made to your files.","text_seo-plugin":"<b>SEO Plugin</b>","text_seo-plugin-tooltip-body":"Set metas, create knowledge graphs, manage site indexing, monitor redirects, and get recommendations to optimize your website SEO.","text_analytics-reports":"<b>Analytics Reports</b>","text_analytics-reports-tooltip-body":"Get a full analysis of your site visits and storage usage reports.","text_email-assistance":"Email assistance","text_email-assistance-tooltip-body":"Submit tickets with any issues you have and our team will get back to you in the shortest time.","text_chat":"Real-time chatbox assistance 24/7","text_chat-tooltip-body":"Our customer support team is at your service 24/7. Reach out to us anytime.","text_top-rated":"Top rated support: 4.9/5 rating on Trustpilot","text_top-rated-tooltip-body":"Our company\'s support is the gold standard in the industry, consistently earning top ratings from satisfied customers.","text_slack-channel":"Slack channel: direct access to 10Web\u2019s engineers","text_slack-channel-tooltip-body":"Improve your experience with our company by gaining direct access to our team of experts through our Slack channel.","text_compatibility":"Compatibility","text_supportForElementor":"Support for Elementor, DIVI, Beaver,<br/>Gutenberg and more","text_supportForElementor-tooltip-body":"10Web Booster has been tested with many website builders including industry leaders like Elementor, DIVI, Beaver, Gutenberg and more.","text_dynamicCacheWoo":"Dynamic caching for Woo-commerce","text_dynamicCacheWoo-tooltip-body":"Unleash the power of lightning-fast page loading and smooth user experience with our dynamic caching technology for WooCommerce, designed to boost your sales and customer satisfaction.","text_majorHostingProviders":"All major hosting providers:<br/>Siteground, Bluehost, Godaddy and more","text_majorHostingProviders-tooltip-body":"10Web Booster has been tested on many website hostings including industry leaders like Siteground, Bluehost, Godaddy, WPEngine, Kinsta and more.","text_testedOnTop":"Tested on top 200 WP plugins and themes","text_testedOnTop-tooltip-body":"10Web Booster was thoroughly tested with the top 200 WordPress plugins and themes for maximum compatibility and efficiency.","text_vip-support":"VIP support","text_vip-support-tooltip-bosy":"Receive top priority assistance from our superstar support team.","text_userManagement":"User & Team Management","text_userAndTeamManagement":"User & Team Management","text_updateUserRole":"Update user role","text_workspaceInfo":"Workspace settings","text_billingDetails":"Billing details","text_invoices":"Invoices","text_addOwnWorkspace":"Add own workspace","text_addWorkspace":"Add Workspace","text_vip-support-tooltip-body":"Directly connect with our VIP support team through our dedicated Slack channel to solve any issue.","text_frontendSpeedIncludes":"Frontend speed optimization","text_frontendSpeedBooster":"Booster","text_frontendSpeed0":"90+ PageSpeed score","text_frontendSpeed1":"Improved Core Web Vitals","text_frontendSpeed2":"Image optimization","text_frontendSpeed3":"Caching","text_cdn-boost":"Up to 60% performance boost","text_frontendSpeed5":"Auto optimization of images","text_frontendSpeed6":"Custom optimization rules","text_frontendSpeed0-tooltip-body":"We achieve 90+ PageSpeed through a series of technical actions including: <br>- CSS & HTML Minification & Compression <br>- JS Minification and Compression <br>- Image Lazyload <br>- Font Swap <br>- iFrame and Video Lazyload","text_frontendSpeed1-tooltip-body":"10Web helps you pass Core Web Vitals Assessment by: <br>- Using Critical CSS <br>- Preload images <br>- Optimize font delivery <br>- Use web workers<br>- Delay or remove non-critical third-party","text_frontendSpeed2-tooltip-body":"10Web optimizes website images through a number of activities: <br>- Converting Image Format to WebP <br>- Container-specific Image Resizing <br>- Lossy reduction <br>- Keeping Full-sized images","text_frontendSpeed3-tooltip-body":"10Web\u2019s advanced caching mechanism caches everything and re-optimizes edited pages to continuously decrease load time.","text_cdn-boost-tooltip-body":"Increase your website performance by up to additional 60% by enabling Cloudflare Enterprise CDN on your website.","text_frontendSpeed5-tooltip-body":"Automatically optimize images uploaded to the media library.","text_frontendSpeed6-tooltip-body":"Customize and manage optimization modes of specific pages on your website.","text_backendSpeedIncludesBooster":"Backend speed optimization <span class=\'notice\'>Only on 10Web hosting</span>","text_backendSpeedIncludes":"Backend speed optimization","text_backendSpeed0":"Google Cloud Premium Tier network","text_backendSpeed0-tooltip-body":"Premium Tier delivers GCP traffic over Google\u2019s well-provisioned, low latency, highly reliable global network.","text_backendSpeed1":"TTFB faster than 200ms","text_backendSpeed1-tooltip-body":"TTFB measures how much time it takes from the initial request for a web page until the first byte of data is returned. If TTFB is slower than 200ms, it affects the overall Server response time, user experience and SEO.","text_backendSpeed2":"Server performance acceleration","text_backendSpeed2-tooltip-body":"Total time of execution calculated by running several tests on PHP and MySQL. This metric affects the speed of WordPress admin and dynamic pages.","text_backendSpeed3":"WordPress performance boost","text_backendSpeed3-tooltip-body":"Time it takes to perform 1000 queries \u2014 250 insert, select, update and delete functions through $wpdb.","text_backendSpeed4":"Up-to-date version of MySQL","text_backendSpeed4-tooltip-body":"10Web supports the up-to-date MySQL version for a faster database and faster performance.","text_backendSpeed5":"Up-to-date PHP version","text_backendSpeed5-tooltip-body":"10Web supports the up-to-date PHP version to improve code execution performance and speed.","text_backendSpeed6":"Database optimization","text_backendSpeed6-tooltip-body":"Optimization of a database (MySQL) specifically designed for WordPress websites.","text_backendSpeed7":"Faster WP Admin & dynamic pages","text_backendSpeed7-tooltip-body":"10Web hosting and subsequent features speed up WP Admin & dynamic pages, minimizing wait time and improving overall experience.","text_removeFeedbackHeader":"You Are About to Permanently Remove<br> Your Website. Please Specify The Reason.","text_removeFeedbackThxHeader":"Thank You For Your Feedback","text_MaxCharLimit":"Maximum character limit is {{limit}}.","text_selectSites":"Select Sites","text_userManagement__invite":"Invite users to your workspace for collaboration.<br> Users can have access to the entire workspace or to specific websites.","text_userManagement__upgrade":"Upgrade now to invite users to your workspace to collaborate. <br> Each user can have access to the whole workspace or only specific sites.","text_userManagement__add-user":"You can add new users or change existing permissions. <br> Each user can have access to the whole company or only specific sites.","text_leaveWorkspace":"Leave Workspace","text_leaveWorkspaceQuestion":"Are you sure you want to leave?</span>","text_leaveWorkspaceConsequence":"Access to <span>{{workspaceName}} Workspace</span> will be revoked.","text_leaveWorkspaceTypePassword":"To leave workspace, please enter your password","text_removeUser":"Remove User","text_removeUserQuestion":"Are you sure you want to remove <b>{{user}}?</b>","text_removeUserConsequence":"Access will be revoked from <b>{{workspaceName}} workspace.</b>","text_removeUserTypePassword":"To remove user, please enter your password <span class=\'red_star\'>*</span>","text_removeUserWPAdminNotifier":"Removing {{user}} from your workspace will not remove WordPress Admin Dashboard users associated with this account.","text_removeUserWPAdminCheck":"I understand that I should remove them manually","text_workspaceAccess":"Workspace access","text_workspaceManageUsers":"Manage users","text_switchingWorkspace":"Switching to {{workspaceName}} Workspace","text_doNotRefresh":"Please do not refresh","text_stagingAccessOnly":"Access to staging environment only","text_pushToLiveDecline":"You have no permission to push<br> staging to live. Please, contact<br> with workspace owner.","text_syncWithLiveDecline":"You have no permission to sync<br> staging with live. Please, contact<br> with workspace owner.","text_migrationFailed":"You don\u2019t have permission to create or copy a website<br> In this workspace, you must switch to the appropriate<br> workspace or contact the owner of this workspace.","text_localTimeZone":"Select your local time zone","text_EmailAddressBellow":"Below is your current email address.","text_resetPasswordLinkInfo":"A link to reset your password will be sent to your email.","text_google2fa":"Google two-factor authentication","text_invalidWorkspaceName":"Workspace name should not contain URL.","text_EmailExceededLimit":"Please enter a maximum of 10 emails to proceed.","text_EmailDuplicate":"Please remove duplicate emails to proceed.","text_OwnEmailInviteError":"You\u2019re already here. Please enter a different email.","text_EmailsExist":"Email(s) already exist.","text_upgradeToAiBuilder":"Do You Want to Use AI Builder with Your Hosting?","text_upgradeToAiBuilderPlanIncludes":"Plan includes","text_upgradeToAiBuilderOpt1":"Unlimited Websites","text_upgradeToAiBuilderOpt2":"AI Recreation Assistant","text_upgradeToAiBuilderOpt3":"90+ Basic & Pro Widgets","text_upgradeToAiBuilderOpt4":"Drag & Drop Editor Based on Elementor","text_upgradeToAiBuilderOpt5":"Theme builder","text_upgradeToAiBuilderOpt6":"Responsive design","text_upgradeToAiBuilderDesc":"This plan allows you to create unlimited websites with our AI Builder on any hosting provider. You can also purchase 10Web-hosted websites later without switching plans.","text_installActivatePluginWP":"Install & activate the plugin from the WP admin","text_chooseProceed":"Choose How You Want To Proceed","text_createNewWPWebsite":"Create a Brand New WordPress<br> Website on 10Web Hosting","text_recreateWithAi":"Recreate any website with AI","text_builderBasedElementor":"Try 10Web builder-based on Elementor","text_useThemePlugin":"Build your website using any theme & plugin","text_automatedMigration":"Automated Migration <br> to Get 90+ PageSpeed Score","text_copyWithoutAffectingWebsite":"Get a copy of your website without affecting the live website","text_anyHostedGet90score":"Any Website Hosted on 10Web Automatically Gets 90+ PageSpeed Score","text_migrateAndTestYour":"Migrate<br/> your website","text_migrateClientsWebsite":"Migrate Your<br/> Client\u2019s Website","text_optimizeWebsite":"Optimize your website<br/> on your existing hosting","text_migrateOpportunityClients":"Unlike other hosting companies, 10Web gives you an opportunity to migrate<br/> your client\u2019s websites & fully test their performance without upgrading to a paid plan.","text_migrateWebsiteFully":"Migrate your websites to 10Web & fully test their performance on a new hosting.","text_migrateWebsiteFullySMB":"Migrate your website to 10Web & fully test its performance on a new hosting.","text_optimizeWebsiteSubTitle":"Speed up your website with 10Web booster and instantly get a 90+ PageSpeed score.","text_installationWontAffect":"Installation of the plugin won\u2019t affect your actual website.","text_installationWontAffectOptimize":"Installation of the plugin won\u2019t affect your live website.","text_zendeskHeader":"Verify Your Email","text_zendeskDesc":"We\u2019ve sent an email to <b>{{email}}</b> to verify your account and grant access to 10Web Help Center. Please check your email.","text_upgradeToHigherPlanDesc":"You currently have {{domainCount}} Hosted Websites. Please choose a higher plan to upgrade.","text_helpImprove10Web":"Help Us Improve 10Web","text_helpImprove10WebDesc":"Help us build a better experience for you by answering these questions\u2024<br> Won\'t take more than 5 seconds.","text_helpImprove10WebInfo":"How would you best describe yourself as?","text_helpImprove10WebOption1":"Digital Agency","text_helpImprove10WebOption2":"Freelance Developer or Designer","text_helpImprove10WebOption3":"E-commerce","text_helpImprove10WebOption4":"Blogger","text_helpImprove10WebOption5":"Other Business","text_helpImprove10WebWhoBuild":"Who are you building this website for?","text_helpImprove10WebWhoCreateTitle":"Thank You For<br/> Completing the Survey","text_helpImprove10WebWhoCreateDesc":"This information will be used to improve 10Web and provide<br/> a better website maintenance experience.","text_smbHireDeveloperTitle":"Who is going to build your website?","text_smbHireDeveloperOption1":"I\u2019ll build it myself","text_smbHireDeveloperOption2":"I\u2019ll invite my developer","text_smbHireDeveloperOption3":"I\u2019m planning to hire a developer","text_hireDevSlackTitle":"Get Connected With a 10Web Approved Agency or Freelancer","text_hireDevSlackDesc":"Join a dedicated Slack channel to connect with your personal Account Manager.<br class=\'db-hide-mobile\' /> We have a list of hundreds of partners and will find the perfect one for your project.","text_hireDevSlackSuccessNote":"<span>Note.</span>You will be prompted to create an account on clicking the \u201cJoin Slack\u201d button in the email.","text_hireDevSlackSuccessTitle":"Request Sent","text_hireDevSlackSuccessDesc1":"You will receive a Slack invitation from your personal Account Manager<br class=\'db-hide-mobile\' /> in less than 12 hours. Don\u2019t forget to check your email.","text_hireDevSlackSuccessDesc2":" If you don\u2019t receive an email within 12 hours, please contact customer<br class=\'db-hide-mobile\' /> support via live chat.","text_getVipSupportSlackTitle":"Get VIP Support in Slack","text_getVipSupportSlackDesc":"Please write your email to be in direct communication with our Director of <br class=\'db-hide-mobile\' />Customer<br class=\'db-mobile\' /> Care in a dedicated Slack channel created<br class=\'db-mobile\' /> just for you.","text_getVipSupportSlackSentDesc":"You will receive a Slack invitation from our <br class=\'db-mobile\' />Director of Customer care<br/> in less than 12<br class=\'db-mobile\' /> hours. Don\u2019t forget to check your email.","text_getVipSupportSlackSentDescAdditional":"If you don\u2019t receive an email within 12 hours,<br class=\'db-mobile\' /> please contact customer<br class=\'db-hide-mobile\' /> support via live chat.","text_getVipSupportSlackSentNote":"You will be prompted to create an<br class=\'db-mobile\' /> account on clicking the \u201cJoin Slack\u201d<br class=\'db-mobile\' /> button in the email.","text_addOwnWorkspaceDialogTitle":"Unlock all of 10Web for free","text_addOwnWorkspaceDialogDesc":"Add your own workspace and<br class=\'ds-hide-desktop\' /> explore 10Web for free.","text_addOwnWorkspaceDialogBodyTitle":"Here\u2019s what you\u2019ll get:","text_addOwnWorkspaceDialogBodyStep1Title":"Create & migrate multiple websites","text_addOwnWorkspaceDialogBodyStep1Desc":"Easily create or migrate websites to<br class=\'ds-hide-desktop\' /> 10Web\u2019s<br class=\'ds-hide-mobile\' /> Google Cloud Partner hosting<br class=\'ds-hide-desktop\' /> and automatically<br class=\'ds-hide-mobile\' /> get 90+ PageSpeed<br class=\'ds-hide-desktop\' /> score.","text_addOwnWorkspaceDialogBodyStep3Title":"Become a 10Web expert","text_addOwnWorkspaceDialogBodyStep3Desc":"Get discovered by numerous businesses <br class=\'ds-hide-desktop\' />hosted on 10Web who need your expertise.<br class=\'ds-hide-desktop\' /> Grow your client base without much effort<br class=\'ds-hide-desktop\' /> from your side.","text_addOwnWorkspaceDialogBodyStep2Title":"Collaborate with your team & clients","text_addOwnWorkspaceDialogBodyStep2Desc":" Invite your team or clients into a unified<br class=\'ds-hide-desktop\' /> workspace<br class=\'ds-hide-mobile\' /> to improve website<br class=\'ds-hide-desktop\' /> management workflow.","text_noCardRequired":"No credit card required","text_availablePlugin":"Also available on WordPress.org","text_disabledAddWebsiteTooltip":"You can\u2019t add a new website while<br/> creation or migration are in progress.","text_migrationInProgressTitle":"The migration of your website<br/> to 10Web is on its way","text_migrationInProgressDesc":"It will take some time depending on the size of your website.","text_migrationInProgressEnableNotif":"enabling push notifications","text_migrationInProgressEnableNotifDesc":"Get notified when your website migration is completed by","text_migrationInProgressEnabledNotifDesc":"Push notifications are enabled. We will notify you when the migration is completed.","text_migrationInProgressSlider":"Here\u2019s what you\u2019re gonna get:","text_migrationSuccessMobileSpeed":"Your Mobile PageSpeed score has increased by {{percent}}%","text_migrationSuccessFastestWebsite":"Your website is now in the top 1% fastest websites of the world\u2024","text_setupTitle":"What do you want to do?","text_setupDesc":"Choose how you want to proceed and we\u2019ll help you get started. Simply follow the steps below.","text_setupChangeHostingBlockTitle":"Migrate WordPress <br class=\'hide-mobile\'/>site to 10Web hosting","text_setupChangeHostingBlockDesc":"Host your WordPress website on 10Web","text_setupOptimizeBlockTitle":"Optimize<br/> a WordPress website","text_setupOptimizeBlockDesc":"Get 90+ PageSpeed<br/> score on any hosting","text_setupCreateBlockTitle":"Create a new <br class=\'hide-mobile\'/>website with AI","text_setupCreateBlockDesc":"Our AI tool will generate tailored content & images","text_setupConvertBlockTitle":"Convert a non-WordPress <br class=\'hide-mobile\'/>site<br class=\'show-mobile\'/> to WordPress with AI","text_setupConvertBlockDesc":"Insert a URL to recreate its layout with AI","text_setupCreateWithPluginBlockTitle":"Install a blank<br/> WP website","text_setupCreateWithPluginBlockDesc":"Use your own<br/> theme & plugins","text_setupOtherBlockTitle":"Looking for<br/>Something Else?","text_setupOtherBlockDesc":"Tell us what you need","text_setupInstallBlankBlockTitle":"Install a blank<br/>WP website","text_setupInstallBlankBlockDesc":"Use own theme and plugins","text_setupFooterDesc":"We\'ll guide you through our setup process to match 10Web with your specific needs. Simply follow the steps above.","text_setupFooterSkipDesc":"If you want to explore 10Web yourself, ","text_setupOtherStepTitle":"Looking for Something Else?","text_setupOtherStepDesc":"Please select the category you need help with.","text_setupOtherStepTextareaDesc":"Please let us know how we can help you below","text_setupOtherStepSuccessTitle":"Thank You for Your Contribution","text_setupOtherStepSuccessDesc":"Our team members will evaluate your request and come back with<br/> a solution on how to improve your experience with 10Web in less than 24 hours.<br/> Make sure to check your email.","text_setupOtherStepSuccessDescFooter":"Until then you can explore 10Web dashboard and functionality.","text_setupOtherStepPluginsQuestion":"Plugins Related Question","text_setupOtherStepPluginsQuestionDesc":"Form Maker, Gallery or bundle","text_setupOtherStepOtherQuestion":"I Have Other Questions","text_setupOtherStepOtherQuestionDesc":"Describe how we can help","text_setupMoveHostingTitle":"Move to 10Web","text_setupMoveHostingDesc":"Please select the type of the website you want to migrate.","text_setupMoveHostingMigrate":"Migrate <br class=\'brdesktop\'/>a WordPress <br class=\'brmobile\'/>Website to 10Web","text_setupMoveHostingOneClickMigrate":"1 click automated migration","text_setupMoveHostingConvertFromAnyPlatform":"Convert <br class=\'brdesktop\'/>to WordPress <br class=\'brmobile\'/>from Any Platform","text_setupMoveHostingRecreateWithAi":"Recreate your website with AI","text_submit":"Submit","text_createWebsiteStepTitle":"Create a Website","text_createWebsiteStepDesc":"Choose how you want to build your new website.","text_createWebsiteStepAiTitle":"AI Builder","text_createWebsiteStepAiDesc":"Recreate any website<br/> with AI assistance","text_createWebsiteStepTemplateTitle":"Templates","text_createWebsiteStepTemplateDesc":"Choose one of 10Web\'s<br/> designer-made templates","text_createWebsiteStepPluginTitle":"Your Theme & Plugins","text_createWebsiteStepPluginDesc":"Build a new website<br/> from scratch","text_createWebsiteOptionsStepDesc":"First let\'s create a blank WordPress website\u2024","text_oneMonthFreeDialogTitle":"Try 10Web Pro for free for 7 days","text_oneMonthFreeDialogDesc":"Build, host and optimize multiple websites using<br/>all premium features of 10Web.","text_oneMonthFreeDialogBodyTitle":"Here\u2019s what you\u2019ll get:","text_oneMonthFreeDialogBodyStep1Title":"Advanced Features","text_oneMonthFreeDialogBodyStep1Desc":"Unlock and test Staging environment, SFTP, SSH,<br class=\'ds-hide-mobile\' /> Real-time automated backups and more.","text_oneMonthFreeDialogBodyStep2Title":"Dedicated Slack Channel for VIP support","text_oneMonthFreeDialogBodyStep2Desc":"Connect with our engineers and work with them directly to solve any issues as quickly as possible.","text_oneMonthFreeDialogBodyStep3Title":"Manage Multiple Websites Simultaneously","text_oneMonthFreeDialogBodyStep3Desc":"Save time by managing and maintaining multiple websites from a single intuitive dashboard.","text_oneMonthFreeDialogBodyStep4Title":"Cancel Anytime","text_oneMonthFreeDialogBodyStep4Desc":"We will send you a reminder email 24 hours before the end of the period.","text_oneMonthFreeDialogBodyStep1TitleNew":"Get a reliable Google Cloud Partner hosting","text_oneMonthFreeDialogBodyStep2TitleNew":"Use our drag & drop editor based on Elementor","text_oneMonthFreeDialogBodyStep3TitleNew":"Get 90+ PageSpeed with 10Web Booster","text_oneMonthFreeDialogBodyStep4TitleNew":"Enable real-time automated backups","text_oneMonthFreeDialogBodyStep5TitleNew":"Use staging environment","text_oneMonthFreeDialogBodyStep6TitleNew":"Turn on white labeling","text_oneMonthFreeOverviewStep1TitleNew":"Get a reliable Google Cloud Partner hosting","text_oneMonthFreeOverviewStep2TitleNew":"Generate content and images with AI builder","text_oneMonthFreeOverviewStep3TitleNew":"Use 10Web editor based on Elementor","text_oneMonthFreeOverviewStep4TitleNew":"Get 90+ PageSpeed with 10Web Booster","text_oneMonthFreeOverviewStep5TitleNew":"Create more pages and websites with AI","text_oneMonthFreeOverviewStep6TitleNew":"Enable real-time automated backups","text_oneMonthFreeOverviewStep7TitleNew":"Turn on white labeling","text_optimizeWithMigrateGet90PageSpeedScore":"Get a 90+ PageSpeed Score","text_optimizeWithMigrateTitle":"Migrate & optimize your website\u2019s PageSpeed score","text_optimizeWithMigrateDesc":"10Web is t